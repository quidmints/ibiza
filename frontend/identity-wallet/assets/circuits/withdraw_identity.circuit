5768875385782146027077203800349093813394302095769180806489828026;\n    let root = lean_imt_inclusion(leaf, 1, siblings, 6);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_43_size37_index18() {\n    let leaf: Field = 2126236364029314878;\n    let siblings: [Field; 8] = [16852632617482436066, 6978173071946353591403813324548590428771367127371020048099257588725769072660, 4381085509329509823454919610091056537875936250480075987814272752001215059159, 9693719778414854223390955772013683441674110985748973847178586942362612604891, 6660117103245118760516634770874656053307135672830281264087498303717135688127, 3535488985782046482267516183190292226464266235459545259931671508204533969394, 0, 0];\n    let expected_root: Field = 14319868135105768875385782146027077203800349093813394302095769180806489828026;\n    let root = lean_imt_inclusion(leaf, 18, siblings, 6);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_44_size37_index35() {\n    let leaf: Field = 10272966334413731388;\n    let siblings: [Field; 8] = [7918882353857294081, 2206610592373038771161869004826748984376739496338694692012757535336524924390, 17198199127986228581, 0, 0, 11437420439414808768797291994202542409100877116322604976970834790112368507037, 0, 0];\n    let expected_root: Field = 14319868135105768875385782146027077203800349093813394302095769180806489828026;\n    let root = lean_imt_inclusion(leaf, 35, siblings, 6);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_45_size37_index36() {\n    let leaf: Field = 17198199127986228581;\n    let siblings: [Field; 8] = [0, 0, 6342008351936654975547799187921999712689366106410302231334357554416436578122, 0, 0, 11437420439414808768797291994202542409100877116322604976970834790112368507037, 0, 0];\n    let expected_root: Field = 14319868135105768875385782146027077203800349093813394302095769180806489828026;\n    let root = lean_imt_inclusion(leaf, 36, siblings, 6);\n    assert(root == expected_root);\n}\n\n","path":"/Users/ricktobacco/Documents/quidmint/ibiza/backend/circuits/pp/src/lean_imt.nr","function_locations":[{"start":1212,"name":"lean_imt_inclusion"},{"start":2653,"name":"test_matches_lean_imt_sol_three_leaves"},{"start":4120,"name":"test_fuzz_0_size1_index0"},{"start":4405,"name":"test_fuzz_1_size2_index0"},{"start":4769,"name":"test_fuzz_2_size2_index1"},{"start":5133,"name":"test_fuzz_3_size3_index0"},{"start":5514,"name":"test_fuzz_4_size3_index1"},{"start":5895,"name":"test_fuzz_5_size3_index2"},{"start":6314,"name":"test_fuzz_6_size4_index0"},{"start":6751,"name":"test_fuzz_7_size4_index1"},{"start":7188,"name":"test_fuzz_8_size4_index2"},{"start":7628,"name":"test_fuzz_9_size4_index3"},{"start":8069,"name":"test_fuzz_10_size5_index0"},{"start":8526,"name":"test_fuzz_11_size5_index1"},{"start":8983,"name":"test_fuzz_12_size5_index2"},{"start":9441,"name":"test_fuzz_13_size5_index3"},{"start":9899,"name":"test_fuzz_14_size5_index4"},{"start":10321,"name":"test_fuzz_15_size6_index0"},{"start":10836,"name":"test_fuzz_16_size6_index1"},{"start":11351,"name":"test_fuzz_17_size6_index2"},{"start":11867,"name":"test_fuzz_18_size6_index3"},{"start":12383,"name":"test_fuzz_19_size6_index4"},{"start":12824,"name":"test_fuzz_20_size6_index5"},{"start":13265,"name":"test_fuzz_21_size7_index0"},{"start":13779,"name":"test_fuzz_22_size7_index1"},{"start":14293,"name":"test_fuzz_23_size7_index2"},{"start":14807,"name":"test_fuzz_24_size7_index3"},{"start":15321,"name":"test_fuzz_25_size7_index4"},{"start":15779,"name":"test_fuzz_26_size7_index5"},{"start":16237,"name":"test_fuzz_27_size7_index6"},{"start":16734,"name":"test_fuzz_28_size8_index0"},{"start":17248,"name":"test_fuzz_29_size8_index1"},{"start":17762,"name":"test_fuzz_30_size8_index2"},{"start":18277,"name":"test_fuzz_31_size8_index3"},{"start":18792,"name":"test_fuzz_32_size8_index4"},{"start":19307,"name":"test_fuzz_33_size8_index5"},{"start":19822,"name":"test_fuzz_34_size8_index6"},{"start":20337,"name":"test_fuzz_35_size8_index7"},{"start":20853,"name":"test_fuzz_36_size13_index0"},{"start":21447,"name":"test_fuzz_37_size13_index1"},{"start":22041,"name":"test_fuzz_38_size13_index6"},{"start":22634,"name":"test_fuzz_39_size13_index11"},{"start":23168,"name":"test_fuzz_40_size13_index12"},{"start":23665,"name":"test_fuzz_41_size37_index0"},{"start":24408,"name":"test_fuzz_42_size37_index1"},{"start":25152,"name":"test_fuzz_43_size37_index18"},{"start":25895,"name":"test_fuzz_44_size37_index35"},{"start":26433,"name":"test_fuzz_45_size37_index36"}]},"69":{"source":"// SMT inclusion + EXCLUSION verification. COPIED from noir_dl_lib/src/smt.nr (a circomlib\n// SMTVerifier port) so `pp` carries no dependency on the passport library - the same reasoning\n// as jubjub.nr and holder_root.nr.\n//\n// VERIFIED COMPATIBLE WITH THE ON-CHAIN REGISTRY: RevocationRegistry uses @solarity's\n// SparseMerkleTree, and test/registry/SmtCompat.t.sol proves solarity and circomlibjs produce\n// byte-identical roots for the same key set. Identical hashing alone would NOT have been enough\n// - bit order and subtree collapsing are free choices - so that root comparison is what licenses\n// this gadget to verify against the registry.\nuse std::hash::Hasher;\nuse poseidon::poseidon::PoseidonHasher;\n// `switcher` inlined below - it is 3 lines, and copying it keeps `pp` free of any dependency on\n// the passport library, exactly as jubjub.nr/holder_root.nr already do.\n\npub fn switcher(l: Field, r: Field, bit: bool) -> (Field, Field){\n    let aux = (r - l) * (bit as Field);\n    (aux + l, -aux + r)\n}\n\nfn smt_hash1(\n    key: Field,\n    value: Field) -> Field{\n    let mut hasher = PoseidonHasher::default();\n    hasher.write(key);\n    hasher.write(value);\n    hasher.write(1);\n    hasher.finish()\n}\n\n\nfn smt_hash2(\n    l: Field,\n    r: Field) -> Field{\n    let mut hasher = PoseidonHasher::default();\n    hasher.write(l);\n    hasher.write(r);\n    hasher.finish()\n}\n\nfn smt_level_ins<let N_LEVELS: u32>(\n    siblings: [Field; N_LEVELS]) -> [Field; N_LEVELS]{\n    let mut done: [Field; (N_LEVELS - 1)] = [0; N_LEVELS - 1];\n    assert(siblings[N_LEVELS - 1].eq(0) as Field == 1, \"SMT inner verification failure\");\n    let mut out = [0; N_LEVELS];\n\n    out[N_LEVELS - 1] = 1 - siblings[N_LEVELS - 2].eq(0) as Field;\n    done[N_LEVELS - 2] = out[N_LEVELS - 1];\n\n    for i in 0..N_LEVELS - 2{\n        out[N_LEVELS - 2 - i] = \n            (1 - done[N_LEVELS - 2 - i]) * \n            (1 - siblings[N_LEVELS - 3 - i].eq(0) as Field);\n        done[N_LEVELS - 3 - i] = \n            out[N_LEVELS - 2 - i] + done[N_LEVELS - 2 - i];\n    }\n    out[0] = 1 - done[0];\n    out\n}\n\nfn smt_verifier_sm(lev_ins: Field, prev_top: Field) -> (Field, Field){\n    let st_inew = prev_top * lev_ins;\n    (st_inew, prev_top - st_inew)\n}\n\nfn smt_verifier_level(\n    st_top: Field,\n    st_inew: Field,\n    sibling: Field,\n    new_1_leaf: Field,\n    lrbit: bool,\n    child: Field\n) -> Field{\n\n    let switcher = switcher(child, sibling, lrbit);\n    let proof_hash = smt_hash2(switcher.0, switcher.1);\n    let from_proof= proof_hash * st_top;\n\n    from_proof + new_1_leaf * st_inew\n}\n\npub fn smt_verifier<let N_LEVELS: u32>(\n    root: Field,\n    leaf: Field,\n    key: Field,\n    siblings: [Field; N_LEVELS]) -> bool{\n    \n    let hash1_new = smt_hash1(key, leaf);\n\n    let key_bits: [bool; 254] = key.to_le_bits();\n    \n    let smt_lev_ins_out = smt_level_ins::<N_LEVELS>(siblings);\n\n    let mut sm_outs: [(Field, Field); N_LEVELS] = [(0,0); N_LEVELS];\n\n    sm_outs[0] = smt_verifier_sm(smt_lev_ins_out[0], 1);\n\n    for i in 1..N_LEVELS{\n        sm_outs[i] = smt_verifier_sm(smt_lev_ins_out[i], sm_outs[i - 1].1);\n    }\n\n    let mut levels: [Field; N_LEVELS] = [0; N_LEVELS];\n\n    levels[N_LEVELS - 1] = smt_verifier_level(sm_outs[N_LEVELS - 1].1, sm_outs[N_LEVELS - 1].0, siblings[N_LEVELS - 1], hash1_new, key_bits[N_LEVELS - 1], 0);\n    for i in 1..N_LEVELS{\n        levels[N_LEVELS - 1 - i] = smt_verifier_level(sm_outs[N_LEVELS - 1 - i].1, sm_outs[N_LEVELS - 1 - i].0, siblings[N_LEVELS - 1 - i], hash1_new, key_bits[N_LEVELS - 1 - i], levels[N_LEVELS - i]);\n    }\n    (levels[0] == root)\n}\n\n\n/*\n * -- EXCLUSION (non-inclusion) support -----------------------------------------------------------\n *\n * The gadget above proves a key IS in the tree. sec. 2.5's revocation design needs the opposite -\n * \"this identity is NOT on the revocation list\" - and a LeanIMT cannot express absence at all,\n * which is why an SMT is used here.\n *\n * This is the rest of circomlib's SMTVerifier, which the port above had dropped: the `fnc`\n * selector and the `oldKey`/`oldValue`/`isOld0` inputs. Non-inclusion has exactly two shapes, and\n * both must be provable:\n *   - THE SLOT IS EMPTY (`is_old0 = 1`): the path to `key` terminates at a zero subtree.\n *   - ANOTHER LEAF SITS THERE (`is_old0 = 0`): the path terminates at a leaf for a DIFFERENT key,\n *     `old_key`, whose presence is what proves `key` cannot also be there.\n *\n * THE SOUNDNESS CONSTRAINT IS `assert_keys_ok`. Without it a prover could pass `old_key == key`\n * and \"prove\" a key is absent while it is demonstrably present - i.e. prove non-revocation while\n * revoked. It is the single most important line here.\n */\n\n/// Full state machine, five states. `smt_verifier_sm` above is this with is0/fnc/iold/i0 dropped.\nfn smt_verifier_sm_full(\n    is0: Field,\n    lev_ins: Field,\n    fnc: Field,\n    prev_top: Field,\n    prev_i0: Field,\n    prev_iold: Field,\n    prev_inew: Field,\n    prev_na: Field,\n) -> (Field, Field, Field, Field, Field) {\n    let prev_top_lev_ins = prev_top * lev_ins;\n    let prev_top_lev_ins_fnc = prev_top_lev_ins * fnc;\n\n    let st_top = prev_top - prev_top_lev_ins;\n    let st_inew = prev_top_lev_ins - prev_top_lev_ins_fnc;\n    let st_iold = prev_top_lev_ins_fnc * (1 - is0);\n    let st_i0 = prev_top_lev_ins * is0;\n    let st_na = prev_na + prev_inew + prev_iold + prev_i0;\n\n    (st_top, st_i0, st_iold, st_inew, st_na)\n}\n\n/// Level hash with all four state contributions. An empty slot (`st_i0`) contributes NOTHING,\n/// which is precisely what makes \"the subtree here is zero\" provable.\nfn smt_verifier_level_full(\n    st_top: Field,\n    st_iold: Field,\n    st_inew: Field,\n    sibling: Field,\n    old_1_leaf: Field,\n    new_1_leaf: Field,\n    lrbit: bool,\n    child: Field,\n) -> Field {\n    let switcher = switcher(child, sibling, lrbit);\n    let proof_hash = smt_hash2(switcher.0, switcher.1);\n\n    proof_hash * st_top + old_1_leaf * st_iold + new_1_leaf * st_inew\n}\n\n/// The soundness constraint. Claiming exclusion (`fnc = 1`) against a NON-empty slot\n/// (`is_old0 = 0`) requires `old_key != key`; otherwise the \"absent\" key is the very leaf being\n/// pointed at. circomlib expresses this as `keysOk.out === 0` over\n/// (fnc AND NOT isOld0 AND keysEqual).\nfn assert_keys_ok(fnc: Field, is_old0: Field, old_key: Field, key: Field) {\n    let keys_equal = (old_key == key) as Field;\n    assert(\n        fnc * (1 - is_old0) * keys_equal == 0,\n        \"SMT exclusion claimed for a key that is present (old_key == key)\",\n    );\n}\n\n/**\n * Verify inclusion (`fnc = 0`) or EXCLUSION (`fnc = 1`) of `key` under `root`.\n *\n * For inclusion, `value` is the leaf value and old_key/old_value/is_old0 are ignored.\n * For exclusion, supply the leaf actually found at the path end: either `is_old0 = 1` (empty), or\n * `is_old0 = 0` with the occupying leaf's `old_key`/`old_value`.\n */\npub fn smt_verifier_full<let N_LEVELS: u32>(\n    root: Field,\n    key: Field,\n    value: Field,\n    old_key: Field,\n    old_value: Field,\n    is_old0: bool,\n    fnc: bool,\n    siblings: [Field; N_LEVELS],\n) -> bool {\n    let fnc_f = fnc as Field;\n    let is0_f = is_old0 as Field;\n\n    assert_keys_ok(fnc_f, is0_f, old_key, key);\n\n    let hash1_old = smt_hash1(old_key, old_value);\n    let hash1_new = smt_hash1(key, value);\n\n    let key_bits: [bool; 254] = key.to_le_bits();\n    let lev_ins = smt_level_ins::<N_LEVELS>(siblings);\n\n    // (top, i0, iold, inew, na), seeded at \"still traversing\".\n    let mut sm: [(Field, Field, Field, Field, Field); N_LEVELS] = [(0, 0, 0, 0, 0); N_LEVELS];\n    sm[0] = smt_verifier_sm_full(is0_f, lev_ins[0], fnc_f, 1, 0, 0, 0, 0);\n    for i in 1..N_LEVELS {\n        let p = sm[i - 1];\n        sm[i] = smt_verifier_sm_full(is0_f, lev_ins[i], fnc_f, p.0, p.1, p.2, p.3, p.4);\n    }\n\n    let mut levels: [Field; N_LEVELS] = [0; N_LEVELS];\n    let last = N_LEVELS - 1;\n    levels[last] = smt_verifier_level_full(\n        sm[last].0,\n        sm[last].2,\n        sm[last].3,\n        siblings[last],\n        hash1_old,\n        hash1_new,\n        key_bits[last],\n        0,\n    );\n    for i in 1..N_LEVELS {\n        let j = last - i;\n        levels[j] = smt_verifier_level_full(\n            sm[j].0,\n            sm[j].2,\n            sm[j].3,\n            siblings[j],\n            hash1_old,\n            hash1_new,\n            key_bits[j],\n            levels[j + 1],\n        );\n    }\n\n    (levels[0] == root)\n}\n\n/*\n * DIFFERENTIAL TESTS against circomlibjs - the implementation this file is a port of.\n *\n * The previous test here was `print(smt_verifier::<80>(...))` with NO ASSERTION: it could not\n * fail, whatever the gadget returned. So the port had never actually been checked against its\n * reference. Vectors below come from circomlibjs 0.1.7, tree built by inserting\n * (1,11), (2,22), (7,77), (9,99) into an empty SMT.\n */\nglobal REF_ROOT: Field =\n    518494836555806875742446376098343000486175381741467406929375446995815951571;\n\n// Inclusion path for key=7, padded to 10 levels.\nfn ref_siblings_key7() -> [Field; 10] {\n    [\n        3538372437315232912232383076351801231931604997820687320170917796819460581158,\n        7219773115889511897248370091680383759521588836236378252329610603114958225446,\n        0, 0, 0, 0, 0, 0, 0, 0,\n    ]\n}\n\n#[test]\nfn test_inclusion_matches_circomlibjs() {\n    assert(\n        smt_verifier::<10>(REF_ROOT, 77, 7, ref_siblings_key7()) == true,\n        \"inclusion proof for key=7 was rejected\",\n    );\n}\n\n/*\n * NEGATIVE CONTROLS. Without these the test above proves nothing: a gadget that returned 1\n * unconditionally would pass it. Each perturbs exactly one input.\n */\n#[test]\nfn test_rejects_wrong_value() {\n    assert(\n        smt_verifier::<10>(REF_ROOT, 78, 7, ref_siblings_key7()) == false,\n        \"a wrong VALUE was accepted\",\n    );\n}\n\n#[test]\nfn test_rejects_wrong_key() {\n    assert(\n        smt_verifier::<10>(REF_ROOT, 77, 8, ref_siblings_key7()) == false,\n        \"a wrong KEY was accepted\",\n    );\n}\n\n#[test]\nfn test_rejects_wrong_root() {\n    assert(\n        smt_verifier::<10>(REF_ROOT + 1, 77, 7, ref_siblings_key7()) == false,\n        \"a wrong ROOT was accepted\",\n    );\n}\n\n#[test]\nfn test_rejects_tampered_sibling() {\n    let mut sib = ref_siblings_key7();\n    sib[0] = sib[0] + 1;\n    assert(smt_verifier::<10>(REF_ROOT, 77, 7, sib) == false, \"a tampered SIBLING was accepted\");\n}\n\n/*\n * EXCLUSION differential tests, same circomlibjs tree as above.\n * Both non-inclusion shapes are covered, because they exercise different states of the machine.\n */\n\n#[test]\nfn test_exclusion_empty_slot_matches_circomlibjs() {\n    // key=5 is absent and the path terminates at an EMPTY subtree (isOld0 = 1).\n    assert(\n        smt_verifier_full::<10>(\n            REF_ROOT, 5, 0, 5, 0, true, true,\n            [\n                3538372437315232912232383076351801231931604997820687320170917796819460581158,\n                7623680454338960526645764969964785413027269598530557012829785131842723566171,\n                12556884404771194108685558266628964754582687227852416218991473495993258837549,\n                0, 0, 0, 0, 0, 0, 0,\n            ],\n        ) == true,\n        \"exclusion proof for absent key=5 (empty slot) was rejected\",\n    );\n}\n\n#[test]\nfn test_exclusion_other_leaf_matches_circomlibjs() {\n    // key=1024 is absent because key=2 (value 22) occupies the slot the path leads to.\n    assert(\n        smt_verifier_full::<10>(\n            REF_ROOT, 1024, 0, 2, 22, false, true,\n            [\n                14615772771365257397421554110268415743234227304552007892570694122567980124822,\n                0, 0, 0, 0, 0, 0, 0, 0, 0,\n            ],\n        ) == true,\n        \"exclusion proof for absent key=1024 (other leaf occupies slot) was rejected\",\n    );\n}\n\n#[test]\nfn test_full_verifier_still_does_inclusion() {\n    // fnc = 0 must reproduce the inclusion gadget's result exactly.\n    assert(\n        smt_verifier_full::<10>(REF_ROOT, 7, 77, 0, 0, false, false, ref_siblings_key7()) == true,\n        \"smt_verifier_full rejected a valid INCLUSION proof\",\n    );\n}\n\n/*\n * THE SOUNDNESS TEST. Claiming a key is absent while pointing at that very key must be\n * impossible - otherwise a revoked identity could prove non-revocation. assert_keys_ok is what\n * stops it, and this is the only test that exercises that line.\n */\n#[test(should_fail_with = \"SMT exclusion claimed for a key that is present (old_key == key)\")]\nfn test_exclusion_cannot_claim_a_present_key() {\n    let _ = smt_verifier_full::<10>(REF_ROOT, 7, 77, 7, 77, false, true, ref_siblings_key7());\n}\n\n#[test]\nfn test_exclusion_rejects_wrong_root() {\n    assert(\n        smt_verifier_full::<10>(\n            REF_ROOT + 1, 1024, 0, 2, 22, false, true,\n            [\n                14615772771365257397421554110268415743234227304552007892570694122567980124822,\n                0, 0, 0, 0, 0, 0, 0, 0, 0,\n            ],\n        ) == false,\n        \"exclusion accepted against a WRONG root\",\n    );\n}\n\n#[test]\nfn test_exclusion_rejects_wrong_old_leaf() {\n    // Same shape as the key=1024 case but the occupying leaf's value is wrong, so the recomputed\n    // root must not match.\n    assert(\n        smt_verifier_full::<10>(\n            REF_ROOT, 1024, 0, 2, 23, false, true,\n            [\n                14615772771365257397421554110268415743234227304552007892570694122567980124822,\n                0, 0, 0, 0, 0, 0, 0, 0, 0,\n            ],\n        ) == false,\n        \"exclusion accepted with a WRONG old_value\",\n    );\n}\n\n/*\n * THE EMPTY-TREE CASE, which every withdrawal fixture depends on and which is easy to assume.\n *\n * A freshly deployed RevocationRegistry has revoked nobody, so its root is 0 and EVERY identity\n * must be able to prove non-inclusion against it with an all-zero witness. If this did not hold,\n * no withdrawal could be proven until somebody was revoked - an absurd bootstrapping requirement\n * that would only surface at deploy time.\n */\n#[test]\nfn test_exclusion_against_the_empty_tree() {\n    assert(\n        smt_verifier_full::<20>(0, 12345, 0, 0, 0, true, true, [0; 20]) == true,\n        \"non-inclusion against an EMPTY revocation tree was rejected\",\n    );\n}\n\n/// The same, for an unrelated key - absence from an empty tree cannot depend on which key is asked.\n#[test]\nfn test_exclusion_against_empty_tree_any_key() {\n    assert(\n        smt_verifier_full::<20>(0, 99999999, 0, 0, 0, true, true, [0; 20]) == true,\n        \"non-inclusion against an EMPTY tree failed for a different key\",\n    );\n}\n\n/*\n * MERGED-TREE SOUNDNESS (sec. 2.13k).\n *\n * The single identity tree encodes STATUS IN THE VALUE: `commitment -> 0` means registered and\n * clean, `commitment -> predicate` means revoked. A withdrawal proves INCLUSION with value 0. That\n * collapses two trees into one and removes 43% of the withdrawal circuit, but it rests entirely on\n * two properties that were NOT previously tested, because no caller had ever used value 0:\n *\n *   1. `key -> 0` must be DISTINGUISHABLE FROM ABSENCE. If proving inclusion-with-value-0 were the\n *      same as proving nothing, ANY unregistered identity could withdraw - the gate would be\n *      vacuous for exactly the population it exists to exclude.\n *   2. The VALUE must be BINDING. If a leaf's value could be misreported, a REVOKED identity\n *      (value = predicate) would simply claim 0 and withdraw anyway, which is the whole failure the\n *      revocation mechanism exists to prevent.\n *\n * Leaf hashing is `Poseidon(key, value, 1)`, so `leaf(k, 0)` is a non-zero hash while an empty node\n * is literal 0 - the two cannot collide. These tests assert that rather than trusting it.\n */\n\n/// A one-entry tree holding key=5 with value 0. For a single-leaf SMT the root IS the leaf hash;\n/// computed with @iden3/js-crypto as Poseidon([5, 0, 1]).\nglobal ZERO_VALUE_ROOT: Field =\n    15739329723942587145467652550645860604592570947603611249889485952228479492237;\n\n#[test]\nfn test_inclusion_with_value_zero_is_provable() {\n    // The \"registered and clean\" case must actually work, or the merged design is dead on arrival.\n    assert(\n        smt_verifier_full::<10>(ZERO_VALUE_ROOT, 5, 0, 0, 0, false, false, [0; 10]) == true,\n        \"a genuine key->0 inclusion proof was rejected\",\n    );\n}\n\n#[test]\nfn test_absent_key_cannot_be_proven_present_with_value_zero() {\n    // THE TRAP. If this passed, every unregistered identity could withdraw.\n    assert(\n        smt_verifier_full::<10>(ZERO_VALUE_ROOT, 6, 0, 0, 0, false, false, [0; 10]) == false,\n        \"an ABSENT key was proven included with value 0 - the merged tree gate is vacuous\",\n    );\n}\n\n#[test]\nfn test_a_revoked_entry_cannot_claim_value_zero() {\n    // THE OTHER TRAP. key=7 is present in REF_ROOT with value 77 - stand-in for a revocation\n    // predicate. Claiming it holds 0 must fail, or revocation can be shrugged off.\n    assert(\n        smt_verifier_full::<10>(REF_ROOT, 7, 0, 0, 0, false, false, ref_siblings_key7()) == false,\n        \"a leaf with a NON-ZERO value was proven to hold 0 - revocation is escapable\",\n    );\n}\n\n#[test]\nfn test_value_zero_inclusion_still_binds_the_root() {\n    // A stale or invented root must not be accepted just because the value is 0.\n    assert(\n        smt_verifier_full::<10>(ZERO_VALUE_ROOT + 1, 5, 0, 0, 0, false, false, [0; 10]) == false,\n        \"key->0 inclusion accepted against the wrong root\",\n    );\n}\n\n#[test]\nfn test_exclusion_against_an_empty_tree_is_the_zero_witness() {\n    // FEASIBILITY GATE for the non-association predicate (TODO 2.18gz-unify).\n    //\n    // A taint set starts EMPTY, and an empty set must admit everyone - that is the fail-open\n    // polarity the whole design rests on. If exclusion against root 0 needs a constructed witness,\n    // every committed withdrawal fixture would need a real taint tree built first. If the all-zero\n    // witness works, the bootstrap is free and the fixtures take zeros.\n    //\n    // `is_old0 = true` is what tells the state machine the tree is empty; `fnc = true` selects\n    // EXCLUSION.\n    let siblings: [Field; 32] = [0; 32];\n    let ok = smt_verifier_full::<32>(\n        0,          // root of an empty tree\n        123456789,  // any key at all\n        0,\n        0,          // old_key\n        0,          // old_value\n        true,       // is_old0 - the tree is empty\n        true,       // fnc - prove EXCLUSION\n        siblings,\n    );\n    assert(ok, \"exclusion from an empty tree must verify with an all-zero witness\");\n}\n\n#[test]\nfn test_a_different_key_also_excludes_from_the_empty_tree() {\n    // Not key-specific: if it were, the \"free bootstrap\" would be an accident of one value.\n    let siblings: [Field; 32] = [0; 32];\n    assert(\n        smt_verifier_full::<32>(0, 987654321, 0, 0, 0, true, true, siblings),\n        \"empty-tree exclusion must hold for any key\",\n    );\n}\n","path":"/Users/ricktobacco/Documents/quidmint/ibiza/backend/circuits/pp/src/smt.nr","function_locations":[{"start":948,"name":"switcher"},{"start":1073,"name":"smt_hash1"},{"start":1266,"name":"smt_hash2"},{"start":1471,"name":"smt_level_ins"},{"start":2146,"name":"smt_verifier_sm"},{"start":2372,"name":"smt_verifier_level"},{"start":2696,"name":"smt_verifier"},{"start":4982,"name":"smt_verifier_sm_full"},{"start":5757,"name":"smt_verifier_level_full"},{"start":6306,"name":"assert_keys_ok"},{"start":7059,"name":"smt_verifier_full"},{"start":8997,"name":"ref_siblings_key7"},{"start":9266,"name":"test_inclusion_matches_circomlibjs"},{"start":9618,"name":"test_rejects_wrong_value"},{"start":9791,"name":"test_rejects_wrong_key"},{"start":9963,"name":"test_rejects_wrong_root"},{"start":10146,"name":"test_rejects_tampered_sibling"},{"start":10542,"name":"test_exclusion_empty_slot_matches_circomlibjs"},{"start":11223,"name":"test_exclusion_other_leaf_matches_circomlibjs"},{"start":11745,"name":"test_full_verifier_still_does_inclusion"},{"start":12397,"name":"test_exclusion_cannot_claim_a_present_key"},{"start":12544,"name":"test_exclusion_rejects_wrong_root"},{"start":12945,"name":"test_exclusion_rejects_wrong_old_leaf"},{"start":13911,"name":"test_exclusion_against_the_empty_tree"},{"start":14243,"name":"test_exclusion_against_empty_tree_any_key"},{"start":15892,"name":"test_inclusion_with_value_zero_is_provable"},{"start":16236,"name":"test_absent_key_cannot_be_proven_present_with_value_zero"},{"start":16581,"name":"test_a_revoked_entry_cannot_claim_value_zero"},{"start":17029,"name":"test_value_zero_inclusion_still_binds_the_root"},{"start":17363,"name":"test_exclusion_against_an_empty_tree_is_the_zero_witness"},{"start":18453,"name":"test_a_different_key_also_excludes_from_the_empty_tree"}]},"71":{"source":"//! The withdrawal statement, extracted so it exists ONCE.\n//!\n//! WHY THIS FILE EXISTS. `withdraw_identity` proves a withdrawal and exposes seven `pub` signals in\n//! the order `ProofLib.WithdrawProof.pubSignals` pins. The IVC/chonk path needs the SAME statement\n//! with a different calling convention: the app circuit returns its signals as `return_data` so a\n//! kernel can consume them through `call_data`, rather than exposing them as public inputs.\n//!\n//! Two `main`s, one statement. Copying the body instead would put the money path in two places, and\n//! the copies would drift the first time either is touched - which is exactly how a fold that\n//! verifies a DIFFERENT statement than the contract checks would arrive, silently.\n//!\n//! THE EXTRACTION MUST NOT CHANGE THE EXISTING CIRCUIT, and that is checkable rather than arguable:\n//! `bb write_vk -t evm` on `withdraw_identity` produced sha256 `366f53d7...` before this file\n//! existed. If it still does, the constraint system is untouched and every generated verifier,\n//! fixture and committed proof remains valid. If it does not, this extraction is wrong and must be\n//! reverted rather than re-pinned.\nuse crate::commitment::commitment_hasher;\nuse crate::envelope::secret_commitment;\nuse crate::lean_imt::lean_imt_inclusion;\nuse crate::smt::smt_verifier_full;\n\n/// SMT depth of the identity registry. MUST equal IdentityRegistry's constructor `treeHeight_` and\n/// the wallet's IDENTITY_TREE_DEPTH. A mismatch fails every proof with no useful diagnostic.\n///\n/// 32, not 20: this tree holds EVERY registered identity, not just revoked ones, so it is the large\n/// tree. Depth 20 caps at ~1M identities and would be cheaper in-circuit (7,889 vs 11,856 opcodes),\n/// but raising a tree's depth later invalidates every proof and forces a migration.\npub global IDENTITY_TREE_DEPTH: u32 = 32;\n\n/// `fnc = 0` selects INCLUSION in smt_verifier_full. Named because passing 1 here would prove the\n/// OPPOSITE - that the identity is absent from the registry - which is what an UNREGISTERED party\n/// can prove and a registered one cannot.\nglobal SMT_INCLUSION: bool = false;\n\n/// `fnc = 1` selects EXCLUSION - proving a key is ABSENT. Named for the same reason as its twin:\n/// passing `false` here would silently prove the opposite of what the taint check means.\nglobal SMT_EXCLUSION: bool = true;\n\n/// The value a clean identity carries. Non-zero means revoked, and the value IS the predicate.\nglobal STATUS_CLEAN: Field = 0;\n\n/// The seven signals, in `ProofLib.WithdrawProof.pubSignals` order. The ORDER is load-bearing in\n/// both directions: the contract indexes these positionally, and `BatchCommitmentLib` folds them\n/// positionally, so a reordering here produces a commitment the contract cannot reproduce.\npub struct WithdrawSignals {\n    pub new_commitment: Field,\n    pub existing_nullifier_hash: Field,\n    pub withdrawn_value: Field,\n    pub state_root: Field,\n    pub state_tree_depth: Field,\n    pub identity_root: Field,\n    pub context: Field,\n    /// Root of the TAINT set - deposits whose provenance is disqualifying. The withdrawal proves\n    /// its `label` is NOT in it (sec. 2.18gz-unify).\n    ///\n    /// EXCLUSION, not inclusion, and the polarity is the point: an empty taint set admits everyone,\n    /// so a stalled feed or an unreachable publisher fails OPEN. Upstream PP proved INCLUSION in an\n    /// approved set, which fails closed - stop publishing and nobody withdraws.\n    pub taint_root: Field,\n}\n\n/// The witness a withdrawal is proven against. Grouped into a struct only so both `main`s can pass\n/// it through without restating eleven parameters; it is not a semantic boundary.\npub struct WithdrawWitness {\n    pub value: Field,\n    pub label: Field,\n    pub nullifier: Field,\n    pub secret: Field,\n    pub state_leaf_index: Field,\n    pub state_siblings: [Field; 32],\n    pub out_nullifier: Field,\n    pub out_secret: Field,\n    pub revocation_secret: Field,\n    pub identity_siblings: [Field; IDENTITY_TREE_DEPTH],\n    /// Exclusion witness for `label` against `taint_root`. For an EMPTY taint set every field is\n    /// zero with `taint_is_old0 = true` - proven in `smt::test_exclusion_against_an_empty_tree_is_\n    /// the_zero_witness`, which is what makes the bootstrap free.\n    pub taint_siblings: [Field; IDENTITY_TREE_DEPTH],\n    pub taint_old_key: Field,\n    pub taint_old_value: Field,\n    pub taint_is_old0: bool,\n}\n\n/// Prove one withdrawal. Constraint-for-constraint the body `withdraw_identity/src/main.nr` carried\n/// before the extraction, in the same order, so the verification key is unchanged.\npub fn verify_withdrawal(signals: WithdrawSignals, w: WithdrawWitness) {\n    // Says \"no gate reads this, and that is intended\" in code rather than in a comment. Without it\n    // the compiler warns `unused variable context` on every build, and a warning that is expected\n    // forever is a warning nobody reads - so the day a public input goes unused BY ACCIDENT, the\n    // diagnostic that would have caught it is already background noise. Costs no constraints.\n    let _ = signals.context;\n\n    // 1. Existing note: reconstruct its commitment + nullifier hash, and prove membership in the\n    // PP state tree at `state_root`. `state_tree_depth` is contract-selectable, capped at\n    // MAX_TREE_DEPTH=32 on-chain, and taken directly as the actual depth - a false depth simply\n    // fails to reconstruct `state_root`, so no separate range check is needed beyond\n    // lean_imt_inclusion's own `assert(actual_depth <= MAX_DEPTH)`.\n    let existing = commitment_hasher(w.value, w.label, w.nullifier, w.secret);\n    assert(existing.nullifier_hash == signals.existing_nullifier_hash);\n    let computed_state_root = lean_imt_inclusion(\n        existing.commitment,\n        w.state_leaf_index,\n        w.state_siblings,\n        signals.state_tree_depth as u32,\n    );\n    assert(computed_state_root == signals.state_root);\n\n    // 2. Value conservation: existing value == withdrawn + carried into the change note.\n    // Range-checked to 128 bits (ample for token amounts) via to_le_bits' own constraint, so the\n    // subtraction below can't wrap the ~254-bit field and hide a fabricated balance.\n    let _value_bits: [bool; 128] = w.value.to_le_bits();\n    let _withdrawn_bits: [bool; 128] = signals.withdrawn_value.to_le_bits();\n    let new_value = w.value - signals.withdrawn_value;\n    let _new_value_bits: [bool; 128] = new_value.to_le_bits();\n\n    // 3. Change note commitment.\n    let out = commitment_hasher(new_value, w.label, w.out_nullifier, w.out_secret);\n    assert(out.commitment == signals.new_commitment);\n\n    // 4. REGISTERED AND NOT REVOKED, in one proof. The withdrawer must know the escrowed\n    // `revocation_secret` whose commitment sits in the identity registry carrying STATUS_CLEAN.\n    //\n    // The key is DERIVED from the secret, never a free input. Letting the prover supply the key\n    // directly would make this vacuous: they would name any clean identity's commitment - all of\n    // which are public in the tree - and withdraw as someone else. Knowledge of the preimage is the\n    // whole gate.\n    let commitment = secret_commitment(w.revocation_secret);\n    let cleared = smt_verifier_full::<IDENTITY_TREE_DEPTH>(\n        signals.identity_root,\n        commitment,\n        STATUS_CLEAN,\n        0,\n        0,\n        false,\n        SMT_INCLUSION,\n        w.identity_siblings,\n    );\n    assert(\n        cleared == true,\n        \"identity is unregistered or revoked, or the inclusion witness is invalid\",\n    );\n\n    // 5. NOT TAINTED. The deposit's `label` must be ABSENT from the taint set.\n    //\n    // This is the Privacy Pools paper's EXCLUSION branch - \"my withdrawal does not come from one of\n    // these deposits\" - as opposed to the membership branch 0xbow deployed. Same object, opposite\n    // failure direction: an allowlist that stops being published censors everyone, a blacklist that\n    // stops being published admits everyone.\n    //\n    // KEYED ON `label`, which is already bound into both commitments above, so the prover cannot\n    // present someone else's provenance. That binding is why this costs one SMT term and not a\n    // redesign.\n    //\n    // ⚠️ THIRD USE OF THE SAME PRIMITIVE. Identity uses it with `fnc = false` (inclusion, status\n    // clean); this uses `fnc = true` (exclusion). Sanctions non-membership will be the same call\n    // again against a different tree. One proof shape, three predicates.\n    let untainted = smt_verifier_full::<IDENTITY_TREE_DEPTH>(\n        signals.taint_root,\n        w.label,\n        0,\n        w.taint_old_key,\n        w.taint_old_value,\n        w.taint_is_old0,\n        SMT_EXCLUSION,\n        w.taint_siblings,\n    );\n    assert(untainted == true, \"this deposit is in the taint set, or the exclusion witness is invalid\");\n}\n","path":"/Users/ricktobacco/Documents/quidmint/ibiza/backend/circuits/pp/src/withdraw.nr","function_locations":[{"start":4689,"name":"verify_withdrawal"}]}}}