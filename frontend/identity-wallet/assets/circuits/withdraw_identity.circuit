{"noir_version":"1.0.0-beta.13+6e469c3004209a8b107e7707306e25c80a110fd6","hash":"13683122388186381922","abi":{"parameters":[{"name":"new_commitment","type":{"kind":"field"},"visibility":"public"},{"name":"existing_nullifier_hash","type":{"kind":"field"},"visibility":"public"},{"name":"withdrawn_value","type":{"kind":"field"},"visibility":"public"},{"name":"state_root","type":{"kind":"field"},"visibility":"public"},{"name":"state_tree_depth","type":{"kind":"field"},"visibility":"public"},{"name":"asp_root","type":{"kind":"field"},"visibility":"public"},{"name":"asp_tree_depth","type":{"kind":"field"},"visibility":"public"},{"name":"context","type":{"kind":"field"},"visibility":"public"},{"name":"revocation_root","type":{"kind":"field"},"visibility":"public"},{"name":"value","type":{"kind":"field"},"visibility":"private"},{"name":"label","type":{"kind":"field"},"visibility":"private"},{"name":"nullifier","type":{"kind":"field"},"visibility":"private"},{"name":"secret","type":{"kind":"field"},"visibility":"private"},{"name":"state_leaf_index","type":{"kind":"field"},"visibility":"private"},{"name":"state_siblings","type":{"kind":"array","length":32,"type":{"kind":"field"}},"visibility":"private"},{"name":"out_nullifier","type":{"kind":"field"},"visibility":"private"},{"name":"out_secret","type":{"kind":"field"},"visibility":"private"},{"name":"sk_identity","type":{"kind":"field"},"visibility":"private"},{"name":"asp_leaf_index","type":{"kind":"field"},"visibility":"private"},{"name":"asp_siblings","type":{"kind":"array","length":32,"type":{"kind":"field"}},"visibility":"private"},{"name":"revocation_old_key","type":{"kind":"field"},"visibility":"private"},{"name":"revocation_old_value","type":{"kind":"field"},"visibility":"private"},{"name":"revocation_is_old0","type":{"kind":"integer","sign":"unsigned","width":1},"visibility":"private"},{"name":"revocation_siblings","type":{"kind":"array","length":20,"type":{"kind":"field"}},"visibility":"private"}],"return_type":null,"error_types":{"4703047920556725948":{"error_kind":"string","string":"Field failed to decompose into specified 254 limbs"},"7827773659689308776":{"error_kind":"string","string":"SMT exclusion claimed for a key that is present (old_key == key)"},"10873058391940071210":{"error_kind":"string","string":"Field failed to decompose into specified 128 limbs"},"11749559189375295905":{"error_kind":"string","string":"SMT inner verification failure"},"15835548349546956319":{"error_kind":"string","string":"Field failed to decompose into specified 32 limbs"},"18406001706969512045":{"error_kind":"string","string":"identity is revoked, or the non-inclusion witness is invalid"}}},"bytecode":"","debug_symbols":"","file_map":{"5":{"source":"use crate::meta::derive_via;\n\n#[derive_via(derive_eq)]\n// docs:start:eq-trait\npub trait Eq {\n    fn eq(self, other: Self) -> bool;\n}\n// docs:end:eq-trait\n\n// docs:start:derive_eq\ncomptime fn derive_eq(s: TypeDefinition) -> Quoted {\n    let signature = quote { fn eq(_self: Self, _other: Self) -> bool };\n    let for_each_field = |name| quote { (_self.$name == _other.$name) };\n    let body = |fields| {\n        if s.fields_as_written().len() == 0 {\n            quote { true }\n        } else {\n            fields\n        }\n    };\n    crate::meta::make_trait_impl(\n        s,\n        quote { $crate::cmp::Eq },\n        signature,\n        for_each_field,\n        quote { & },\n        body,\n    )\n}\n// docs:end:derive_eq\n\nimpl Eq for Field {\n    fn eq(self, other: Field) -> bool {\n        self == other\n    }\n}\n\nimpl Eq for u128 {\n    fn eq(self, other: u128) -> bool {\n        self == other\n    }\n}\nimpl Eq for u64 {\n    fn eq(self, other: u64) -> bool {\n        self == other\n    }\n}\nimpl Eq for u32 {\n    fn eq(self, other: u32) -> bool {\n        self == other\n    }\n}\nimpl Eq for u16 {\n    fn eq(self, other: u16) -> bool {\n        self == other\n    }\n}\nimpl Eq for u8 {\n    fn eq(self, other: u8) -> bool {\n        self == other\n    }\n}\nimpl Eq for u1 {\n    fn eq(self, other: u1) -> bool {\n        self == other\n    }\n}\n\nimpl Eq for i8 {\n    fn eq(self, other: i8) -> bool {\n        self == other\n    }\n}\nimpl Eq for i16 {\n    fn eq(self, other: i16) -> bool {\n        self == other\n    }\n}\nimpl Eq for i32 {\n    fn eq(self, other: i32) -> bool {\n        self == other\n    }\n}\nimpl Eq for i64 {\n    fn eq(self, other: i64) -> bool {\n        self == other\n    }\n}\n\nimpl Eq for () {\n    fn eq(_self: Self, _other: ()) -> bool {\n        true\n    }\n}\nimpl Eq for bool {\n    fn eq(self, other: bool) -> bool {\n        self == other\n    }\n}\n\nimpl<T, let N: u32> Eq for [T; N]\nwhere\n    T: Eq,\n{\n    fn eq(self, other: [T; N]) -> bool {\n        let mut result = true;\n        for i in 0..self.len() {\n            result &= self[i].eq(other[i]);\n        }\n        result\n    }\n}\n\nimpl<T> Eq for [T]\nwhere\n    T: Eq,\n{\n    fn eq(self, other: [T]) -> bool {\n        let mut result = self.len() == other.len();\n        if result {\n            for i in 0..self.len() {\n                result &= self[i].eq(other[i]);\n            }\n        }\n        result\n    }\n}\n\nimpl<let N: u32> Eq for str<N> {\n    fn eq(self, other: str<N>) -> bool {\n        let self_bytes = self.as_bytes();\n        let other_bytes = other.as_bytes();\n        self_bytes == other_bytes\n    }\n}\n\nimpl<A, B> Eq for (A, B)\nwhere\n    A: Eq,\n    B: Eq,\n{\n    fn eq(self, other: (A, B)) -> bool {\n        self.0.eq(other.0) & self.1.eq(other.1)\n    }\n}\n\nimpl<A, B, C> Eq for (A, B, C)\nwhere\n    A: Eq,\n    B: Eq,\n    C: Eq,\n{\n    fn eq(self, other: (A, B, C)) -> bool {\n        self.0.eq(other.0) & self.1.eq(other.1) & self.2.eq(other.2)\n    }\n}\n\nimpl<A, B, C, D> Eq for (A, B, C, D)\nwhere\n    A: Eq,\n    B: Eq,\n    C: Eq,\n    D: Eq,\n{\n    fn eq(self, other: (A, B, C, D)) -> bool {\n        self.0.eq(other.0) & self.1.eq(other.1) & self.2.eq(other.2) & self.3.eq(other.3)\n    }\n}\n\nimpl<A, B, C, D, E> Eq for (A, B, C, D, E)\nwhere\n    A: Eq,\n    B: Eq,\n    C: Eq,\n    D: Eq,\n    E: Eq,\n{\n    fn eq(self, other: (A, B, C, D, E)) -> bool {\n        self.0.eq(other.0)\n            & self.1.eq(other.1)\n            & self.2.eq(other.2)\n            & self.3.eq(other.3)\n            & self.4.eq(other.4)\n    }\n}\n\nimpl Eq for Ordering {\n    fn eq(self, other: Ordering) -> bool {\n        self.result == other.result\n    }\n}\n\n// Noir doesn't have enums yet so we emulate (Lt | Eq | Gt) with a struct\n// that has 3 public functions for constructing the struct.\npub struct Ordering {\n    result: Field,\n}\n\nimpl Ordering {\n    // Implementation note: 0, 1, and 2 for Lt, Eq, and Gt are built\n    // into the compiler, do not change these without also updating\n    // the compiler itself!\n    pub fn less() -> Ordering {\n        Ordering { result: 0 }\n    }\n\n    pub fn equal() -> Ordering {\n        Ordering { result: 1 }\n    }\n\n    pub fn greater() -> Ordering {\n        Ordering { result: 2 }\n    }\n}\n\n#[derive_via(derive_ord)]\n// docs:start:ord-trait\npub trait Ord {\n    fn cmp(self, other: Self) -> Ordering;\n}\n// docs:end:ord-trait\n\n// docs:start:derive_ord\ncomptime fn derive_ord(s: TypeDefinition) -> Quoted {\n    let name = quote { $crate::cmp::Ord };\n    let signature = quote { fn cmp(_self: Self, _other: Self) -> $crate::cmp::Ordering };\n    let for_each_field = |name| quote {\n        if result == $crate::cmp::Ordering::equal() {\n            result = _self.$name.cmp(_other.$name);\n        }\n    };\n    let body = |fields| quote {\n        let mut result = $crate::cmp::Ordering::equal();\n        $fields\n        result\n    };\n    crate::meta::make_trait_impl(s, name, signature, for_each_field, quote {}, body)\n}\n// docs:end:derive_ord\n\n// Note: Field deliberately does not implement Ord\n\nimpl Ord for u128 {\n    fn cmp(self, other: u128) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\nimpl Ord for u64 {\n    fn cmp(self, other: u64) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl Ord for u32 {\n    fn cmp(self, other: u32) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl Ord for u16 {\n    fn cmp(self, other: u16) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl Ord for u8 {\n    fn cmp(self, other: u8) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl Ord for i8 {\n    fn cmp(self, other: i8) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl Ord for i16 {\n    fn cmp(self, other: i16) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl Ord for i32 {\n    fn cmp(self, other: i32) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl Ord for i64 {\n    fn cmp(self, other: i64) -> Ordering {\n        if self < other {\n            Ordering::less()\n        } else if self > other {\n            Ordering::greater()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl Ord for () {\n    fn cmp(_self: Self, _other: ()) -> Ordering {\n        Ordering::equal()\n    }\n}\n\nimpl Ord for bool {\n    fn cmp(self, other: bool) -> Ordering {\n        if self {\n            if other {\n                Ordering::equal()\n            } else {\n                Ordering::greater()\n            }\n        } else if other {\n            Ordering::less()\n        } else {\n            Ordering::equal()\n        }\n    }\n}\n\nimpl<T, let N: u32> Ord for [T; N]\nwhere\n    T: Ord,\n{\n    // The first non-equal element of both arrays determines\n    // the ordering for the whole array.\n    fn cmp(self, other: [T; N]) -> Ordering {\n        let mut result = Ordering::equal();\n        for i in 0..self.len() {\n            if result == Ordering::equal() {\n                result = self[i].cmp(other[i]);\n            }\n        }\n        result\n    }\n}\n\nimpl<T> Ord for [T]\nwhere\n    T: Ord,\n{\n    // The first non-equal element of both arrays determines\n    // the ordering for the whole array.\n    fn cmp(self, other: [T]) -> Ordering {\n        let self_len = self.len();\n        let other_len = other.len();\n        let min_len = if self_len < other_len {\n            self_len\n        } else {\n            other_len\n        };\n\n        let mut result = Ordering::equal();\n        for i in 0..min_len {\n            if result == Ordering::equal() {\n                result = self[i].cmp(other[i]);\n            }\n        }\n\n        if result != Ordering::equal() {\n            result\n        } else {\n            self_len.cmp(other_len)\n        }\n    }\n}\n\nimpl<A, B> Ord for (A, B)\nwhere\n    A: Ord,\n    B: Ord,\n{\n    fn cmp(self, other: (A, B)) -> Ordering {\n        let result = self.0.cmp(other.0);\n\n        if result != Ordering::equal() {\n            result\n        } else {\n            self.1.cmp(other.1)\n        }\n    }\n}\n\nimpl<A, B, C> Ord for (A, B, C)\nwhere\n    A: Ord,\n    B: Ord,\n    C: Ord,\n{\n    fn cmp(self, other: (A, B, C)) -> Ordering {\n        let mut result = self.0.cmp(other.0);\n\n        if result == Ordering::equal() {\n            result = self.1.cmp(other.1);\n        }\n\n        if result == Ordering::equal() {\n            result = self.2.cmp(other.2);\n        }\n\n        result\n    }\n}\n\nimpl<A, B, C, D> Ord for (A, B, C, D)\nwhere\n    A: Ord,\n    B: Ord,\n    C: Ord,\n    D: Ord,\n{\n    fn cmp(self, other: (A, B, C, D)) -> Ordering {\n        let mut result = self.0.cmp(other.0);\n\n        if result == Ordering::equal() {\n            result = self.1.cmp(other.1);\n        }\n\n        if result == Ordering::equal() {\n            result = self.2.cmp(other.2);\n        }\n\n        if result == Ordering::equal() {\n            result = self.3.cmp(other.3);\n        }\n\n        result\n    }\n}\n\nimpl<A, B, C, D, E> Ord for (A, B, C, D, E)\nwhere\n    A: Ord,\n    B: Ord,\n    C: Ord,\n    D: Ord,\n    E: Ord,\n{\n    fn cmp(self, other: (A, B, C, D, E)) -> Ordering {\n        let mut result = self.0.cmp(other.0);\n\n        if result == Ordering::equal() {\n            result = self.1.cmp(other.1);\n        }\n\n        if result == Ordering::equal() {\n            result = self.2.cmp(other.2);\n        }\n\n        if result == Ordering::equal() {\n            result = self.3.cmp(other.3);\n        }\n\n        if result == Ordering::equal() {\n            result = self.4.cmp(other.4);\n        }\n\n        result\n    }\n}\n\n// Compares and returns the maximum of two values.\n//\n// Returns the second argument if the comparison determines them to be equal.\n//\n// # Examples\n//\n// ```\n// use std::cmp;\n//\n// assert_eq(cmp::max(1, 2), 2);\n// assert_eq(cmp::max(2, 2), 2);\n// ```\npub fn max<T>(v1: T, v2: T) -> T\nwhere\n    T: Ord,\n{\n    if v1 > v2 {\n        v1\n    } else {\n        v2\n    }\n}\n\n// Compares and returns the minimum of two values.\n//\n// Returns the first argument if the comparison determines them to be equal.\n//\n// # Examples\n//\n// ```\n// use std::cmp;\n//\n// assert_eq(cmp::min(1, 2), 1);\n// assert_eq(cmp::min(2, 2), 2);\n// ```\npub fn min<T>(v1: T, v2: T) -> T\nwhere\n    T: Ord,\n{\n    if v1 > v2 {\n        v2\n    } else {\n        v1\n    }\n}\n\nmod cmp_tests {\n    use super::{Eq, max, min, Ord};\n\n    #[test]\n    fn sanity_check_min() {\n        assert_eq(min(0_u64, 1), 0);\n        assert_eq(min(0_u64, 0), 0);\n        assert_eq(min(1_u64, 1), 1);\n        assert_eq(min(255_u8, 0), 0);\n    }\n\n    #[test]\n    fn sanity_check_max() {\n        assert_eq(max(0_u64, 1), 1);\n        assert_eq(max(0_u64, 0), 0);\n        assert_eq(max(1_u64, 1), 1);\n        assert_eq(max(255_u8, 0), 255);\n    }\n\n    #[test]\n    fn correctly_handles_unequal_length_slices() {\n        let slice_1 = &[0, 1, 2, 3];\n        let slice_2 = &[0, 1, 2];\n        assert(!slice_1.eq(slice_2));\n    }\n\n    #[test]\n    fn lexicographic_ordering_for_slices() {\n        assert(&[2_u32].cmp(&[1_u32, 1_u32, 1_u32]) == super::Ordering::greater());\n        assert(&[1_u32, 2_u32].cmp(&[1_u32, 2_u32, 3_u32]) == super::Ordering::less());\n    }\n}\n","path":"std/cmp.nr"},"18":{"source":"pub mod bn254;\nuse crate::{runtime::is_unconstrained, static_assert};\nuse bn254::lt as bn254_lt;\n\nimpl Field {\n    /// Asserts that `self` can be represented in `bit_size` bits.\n    ///\n    /// # Failures\n    /// Causes a constraint failure for `Field` values exceeding `2^{bit_size}`.\n    // docs:start:assert_max_bit_size\n    pub fn assert_max_bit_size<let BIT_SIZE: u32>(self) {\n        // docs:end:assert_max_bit_size\n        static_assert(\n            BIT_SIZE < modulus_num_bits() as u32,\n            \"BIT_SIZE must be less than modulus_num_bits\",\n        );\n        __assert_max_bit_size(self, BIT_SIZE);\n    }\n\n    /// Decomposes `self` into its little endian bit decomposition as a `[u1; N]` array.\n    /// This slice will be zero padded should not all bits be necessary to represent `self`.\n    ///\n    /// # Failures\n    /// Causes a constraint failure for `Field` values exceeding `2^N` as the resulting slice will not\n    /// be able to represent the original `Field`.\n    ///\n    /// # Safety\n    /// The bit decomposition returned is canonical and is guaranteed to not overflow the modulus.\n    // docs:start:to_le_bits\n    pub fn to_le_bits<let N: u32>(self: Self) -> [u1; N] {\n        // docs:end:to_le_bits\n        let bits = __to_le_bits(self);\n\n        if !is_unconstrained() {\n            // Ensure that the byte decomposition does not overflow the modulus\n            let p = modulus_le_bits();\n            assert(bits.len() <= p.len());\n            let mut ok = bits.len() != p.len();\n            for i in 0..N {\n                if !ok {\n                    if (bits[N - 1 - i] != p[N - 1 - i]) {\n                        assert(p[N - 1 - i] == 1);\n                        ok = true;\n                    }\n                }\n            }\n            assert(ok);\n        }\n        bits\n    }\n\n    /// Decomposes `self` into its big endian bit decomposition as a `[u1; N]` array.\n    /// This array will be zero padded should not all bits be necessary to represent `self`.\n    ///\n    /// # Failures\n    /// Causes a constraint failure for `Field` values exceeding `2^N` as the resulting slice will not\n    /// be able to represent the original `Field`.\n    ///\n    /// # Safety\n    /// The bit decomposition returned is canonical and is guaranteed to not overflow the modulus.\n    // docs:start:to_be_bits\n    pub fn to_be_bits<let N: u32>(self: Self) -> [u1; N] {\n        // docs:end:to_be_bits\n        let bits = __to_be_bits(self);\n\n        if !is_unconstrained() {\n            // Ensure that the decomposition does not overflow the modulus\n            let p = modulus_be_bits();\n            assert(bits.len() <= p.len());\n            let mut ok = bits.len() != p.len();\n            for i in 0..N {\n                if !ok {\n                    if (bits[i] != p[i]) {\n                        assert(p[i] == 1);\n                        ok = true;\n                    }\n                }\n            }\n            assert(ok);\n        }\n        bits\n    }\n\n    /// Decomposes `self` into its little endian byte decomposition as a `[u8;N]` array\n    /// This array will be zero padded should not all bytes be necessary to represent `self`.\n    ///\n    /// # Failures\n    ///  The length N of the array must be big enough to contain all the bytes of the 'self',\n    ///  and no more than the number of bytes required to represent the field modulus\n    ///\n    /// # Safety\n    /// The result is ensured to be the canonical decomposition of the field element\n    // docs:start:to_le_bytes\n    pub fn to_le_bytes<let N: u32>(self: Self) -> [u8; N] {\n        // docs:end:to_le_bytes\n        static_assert(\n            N <= modulus_le_bytes().len(),\n            \"N must be less than or equal to modulus_le_bytes().len()\",\n        );\n        // Compute the byte decomposition\n        let bytes = self.to_le_radix(256);\n\n        if !is_unconstrained() {\n            // Ensure that the byte decomposition does not overflow the modulus\n            let p = modulus_le_bytes();\n            assert(bytes.len() <= p.len());\n            let mut ok = bytes.len() != p.len();\n            for i in 0..N {\n                if !ok {\n                    if (bytes[N - 1 - i] != p[N - 1 - i]) {\n                        assert(bytes[N - 1 - i] < p[N - 1 - i]);\n                        ok = true;\n                    }\n                }\n            }\n            assert(ok);\n        }\n        bytes\n    }\n\n    /// Decomposes `self` into its big endian byte decomposition as a `[u8;N]` array of length required to represent the field modulus\n    /// This array will be zero padded should not all bytes be necessary to represent `self`.\n    ///\n    /// # Failures\n    ///  The length N of the array must be big enough to contain all the bytes of the 'self',\n    ///  and no more than the number of bytes required to represent the field modulus\n    ///\n    /// # Safety\n    /// The result is ensured to be the canonical decomposition of the field element\n    // docs:start:to_be_bytes\n    pub fn to_be_bytes<let N: u32>(self: Self) -> [u8; N] {\n        // docs:end:to_be_bytes\n        static_assert(\n            N <= modulus_le_bytes().len(),\n            \"N must be less than or equal to modulus_le_bytes().len()\",\n        );\n        // Compute the byte decomposition\n        let bytes = self.to_be_radix(256);\n\n        if !is_unconstrained() {\n            // Ensure that the byte decomposition does not overflow the modulus\n            let p = modulus_be_bytes();\n            assert(bytes.len() <= p.len());\n            let mut ok = bytes.len() != p.len();\n            for i in 0..N {\n                if !ok {\n                    if (bytes[i] != p[i]) {\n                        assert(bytes[i] < p[i]);\n                        ok = true;\n                    }\n                }\n            }\n            assert(ok);\n        }\n        bytes\n    }\n\n    fn to_le_radix<let N: u32>(self: Self, radix: u32) -> [u8; N] {\n        // Brillig does not need an immediate radix\n        if !crate::runtime::is_unconstrained() {\n            static_assert(1 < radix, \"radix must be greater than 1\");\n            static_assert(radix <= 256, \"radix must be less than or equal to 256\");\n            static_assert(radix & (radix - 1) == 0, \"radix must be a power of 2\");\n        }\n        __to_le_radix(self, radix)\n    }\n\n    fn to_be_radix<let N: u32>(self: Self, radix: u32) -> [u8; N] {\n        // Brillig does not need an immediate radix\n        if !crate::runtime::is_unconstrained() {\n            static_assert(1 < radix, \"radix must be greater than 1\");\n            static_assert(radix <= 256, \"radix must be less than or equal to 256\");\n            static_assert(radix & (radix - 1) == 0, \"radix must be a power of 2\");\n        }\n        __to_be_radix(self, radix)\n    }\n\n    // Returns self to the power of the given exponent value.\n    // Caution: we assume the exponent fits into 32 bits\n    // using a bigger bit size impacts negatively the performance and should be done only if the exponent does not fit in 32 bits\n    pub fn pow_32(self, exponent: Field) -> Field {\n        let mut r: Field = 1;\n        let b: [u1; 32] = exponent.to_le_bits();\n\n        for i in 1..33 {\n            r *= r;\n            r = (b[32 - i] as Field) * (r * self) + (1 - b[32 - i] as Field) * r;\n        }\n        r\n    }\n\n    // Parity of (prime) Field element, i.e. sgn0(x mod p) = 0 if x `elem` {0, ..., p-1} is even, otherwise sgn0(x mod p) = 1.\n    pub fn sgn0(self) -> u1 {\n        self as u1\n    }\n\n    pub fn lt(self, another: Field) -> bool {\n        if crate::compat::is_bn254() {\n            bn254_lt(self, another)\n        } else {\n            lt_fallback(self, another)\n        }\n    }\n\n    /// Convert a little endian byte array to a field element.\n    /// If the provided byte array overflows the field modulus then the Field will silently wrap around.\n    pub fn from_le_bytes<let N: u32>(bytes: [u8; N]) -> Field {\n        static_assert(\n            N <= modulus_le_bytes().len(),\n            \"N must be less than or equal to modulus_le_bytes().len()\",\n        );\n        let mut v = 1;\n        let mut result = 0;\n\n        for i in 0..N {\n            result += (bytes[i] as Field) * v;\n            v = v * 256;\n        }\n        result\n    }\n\n    /// Convert a big endian byte array to a field element.\n    /// If the provided byte array overflows the field modulus then the Field will silently wrap around.\n    pub fn from_be_bytes<let N: u32>(bytes: [u8; N]) -> Field {\n        let mut v = 1;\n        let mut result = 0;\n\n        for i in 0..N {\n            result += (bytes[N - 1 - i] as Field) * v;\n            v = v * 256;\n        }\n        result\n    }\n}\n\n#[builtin(apply_range_constraint)]\nfn __assert_max_bit_size(value: Field, bit_size: u32) {}\n\n// `_radix` must be less than 256\n#[builtin(to_le_radix)]\nfn __to_le_radix<let N: u32>(value: Field, radix: u32) -> [u8; N] {}\n\n// `_radix` must be less than 256\n#[builtin(to_be_radix)]\nfn __to_be_radix<let N: u32>(value: Field, radix: u32) -> [u8; N] {}\n\n/// Decomposes `self` into its little endian bit decomposition as a `[u1; N]` array.\n/// This slice will be zero padded should not all bits be necessary to represent `self`.\n///\n/// # Failures\n/// Causes a constraint failure for `Field` values exceeding `2^N` as the resulting slice will not\n/// be able to represent the original `Field`.\n///\n/// # Safety\n/// Values of `N` equal to or greater than the number of bits necessary to represent the `Field` modulus\n/// (e.g. 254 for the BN254 field) allow for multiple bit decompositions. This is due to how the `Field` will\n/// wrap around due to overflow when verifying the decomposition.\n#[builtin(to_le_bits)]\nfn __to_le_bits<let N: u32>(value: Field) -> [u1; N] {}\n\n/// Decomposes `self` into its big endian bit decomposition as a `[u1; N]` array.\n/// This array will be zero padded should not all bits be necessary to represent `self`.\n///\n/// # Failures\n/// Causes a constraint failure for `Field` values exceeding `2^N` as the resulting slice will not\n/// be able to represent the original `Field`.\n///\n/// # Safety\n/// Values of `N` equal to or greater than the number of bits necessary to represent the `Field` modulus\n/// (e.g. 254 for the BN254 field) allow for multiple bit decompositions. This is due to how the `Field` will\n/// wrap around due to overflow when verifying the decomposition.\n#[builtin(to_be_bits)]\nfn __to_be_bits<let N: u32>(value: Field) -> [u1; N] {}\n\n#[builtin(modulus_num_bits)]\npub comptime fn modulus_num_bits() -> u64 {}\n\n#[builtin(modulus_be_bits)]\npub comptime fn modulus_be_bits() -> [u1] {}\n\n#[builtin(modulus_le_bits)]\npub comptime fn modulus_le_bits() -> [u1] {}\n\n#[builtin(modulus_be_bytes)]\npub comptime fn modulus_be_bytes() -> [u8] {}\n\n#[builtin(modulus_le_bytes)]\npub comptime fn modulus_le_bytes() -> [u8] {}\n\n/// An unconstrained only built in to efficiently compare fields.\n#[builtin(field_less_than)]\nunconstrained fn __field_less_than(x: Field, y: Field) -> bool {}\n\npub(crate) unconstrained fn field_less_than(x: Field, y: Field) -> bool {\n    __field_less_than(x, y)\n}\n\n// Convert a 32 byte array to a field element by modding\npub fn bytes32_to_field(bytes32: [u8; 32]) -> Field {\n    // Convert it to a field element\n    let mut v = 1;\n    let mut high = 0 as Field;\n    let mut low = 0 as Field;\n\n    for i in 0..16 {\n        high = high + (bytes32[15 - i] as Field) * v;\n        low = low + (bytes32[16 + 15 - i] as Field) * v;\n        v = v * 256;\n    }\n    // Abuse that a % p + b % p = (a + b) % p and that low < p\n    low + high * v\n}\n\nfn lt_fallback(x: Field, y: Field) -> bool {\n    if is_unconstrained() {\n        // Safety: unconstrained context\n        unsafe {\n            field_less_than(x, y)\n        }\n    } else {\n        let x_bytes: [u8; 32] = x.to_le_bytes();\n        let y_bytes: [u8; 32] = y.to_le_bytes();\n        let mut x_is_lt = false;\n        let mut done = false;\n        for i in 0..32 {\n            if (!done) {\n                let x_byte = x_bytes[32 - 1 - i] as u8;\n                let y_byte = y_bytes[32 - 1 - i] as u8;\n                let bytes_match = x_byte == y_byte;\n                if !bytes_match {\n                    x_is_lt = x_byte < y_byte;\n                    done = true;\n                }\n            }\n        }\n        x_is_lt\n    }\n}\n\nmod tests {\n    use crate::{panic::panic, runtime};\n    use super::field_less_than;\n\n    #[test]\n    // docs:start:to_be_bits_example\n    fn test_to_be_bits() {\n        let field = 2;\n        let bits: [u1; 8] = field.to_be_bits();\n        assert_eq(bits, [0, 0, 0, 0, 0, 0, 1, 0]);\n    }\n    // docs:end:to_be_bits_example\n\n    #[test]\n    // docs:start:to_le_bits_example\n    fn test_to_le_bits() {\n        let field = 2;\n        let bits: [u1; 8] = field.to_le_bits();\n        assert_eq(bits, [0, 1, 0, 0, 0, 0, 0, 0]);\n    }\n    // docs:end:to_le_bits_example\n\n    #[test]\n    // docs:start:to_be_bytes_example\n    fn test_to_be_bytes() {\n        let field = 2;\n        let bytes: [u8; 8] = field.to_be_bytes();\n        assert_eq(bytes, [0, 0, 0, 0, 0, 0, 0, 2]);\n        assert_eq(Field::from_be_bytes::<8>(bytes), field);\n    }\n    // docs:end:to_be_bytes_example\n\n    #[test]\n    // docs:start:to_le_bytes_example\n    fn test_to_le_bytes() {\n        let field = 2;\n        let bytes: [u8; 8] = field.to_le_bytes();\n        assert_eq(bytes, [2, 0, 0, 0, 0, 0, 0, 0]);\n        assert_eq(Field::from_le_bytes::<8>(bytes), field);\n    }\n    // docs:end:to_le_bytes_example\n\n    #[test]\n    // docs:start:to_be_radix_example\n    fn test_to_be_radix() {\n        // 259, in base 256, big endian, is [1, 3].\n        // i.e. 3 * 256^0 + 1 * 256^1\n        let field = 259;\n\n        // The radix (in this example, 256) must be a power of 2.\n        // The length of the returned byte array can be specified to be\n        // >= the amount of space needed.\n        let bytes: [u8; 8] = field.to_be_radix(256);\n        assert_eq(bytes, [0, 0, 0, 0, 0, 0, 1, 3]);\n        assert_eq(Field::from_be_bytes::<8>(bytes), field);\n    }\n    // docs:end:to_be_radix_example\n\n    #[test]\n    // docs:start:to_le_radix_example\n    fn test_to_le_radix() {\n        // 259, in base 256, little endian, is [3, 1].\n        // i.e. 3 * 256^0 + 1 * 256^1\n        let field = 259;\n\n        // The radix (in this example, 256) must be a power of 2.\n        // The length of the returned byte array can be specified to be\n        // >= the amount of space needed.\n        let bytes: [u8; 8] = field.to_le_radix(256);\n        assert_eq(bytes, [3, 1, 0, 0, 0, 0, 0, 0]);\n        assert_eq(Field::from_le_bytes::<8>(bytes), field);\n    }\n    // docs:end:to_le_radix_example\n\n    #[test(should_fail_with = \"radix must be greater than 1\")]\n    fn test_to_le_radix_1() {\n        // this test should only fail in constrained mode\n        if !runtime::is_unconstrained() {\n            let field = 2;\n            let _: [u8; 8] = field.to_le_radix(1);\n        } else {\n            panic(f\"radix must be greater than 1\");\n        }\n    }\n\n    // Updated test to account for Brillig restriction that radix must be greater than 2\n    #[test(should_fail_with = \"radix must be greater than 1\")]\n    fn test_to_le_radix_brillig_1() {\n        // this test should only fail in constrained mode\n        if !runtime::is_unconstrained() {\n            let field = 1;\n            let _: [u8; 8] = field.to_le_radix(1);\n        } else {\n            panic(f\"radix must be greater than 1\");\n        }\n    }\n\n    #[test(should_fail_with = \"radix must be a power of 2\")]\n    fn test_to_le_radix_3() {\n        // this test should only fail in constrained mode\n        if !runtime::is_unconstrained() {\n            let field = 2;\n            let _: [u8; 8] = field.to_le_radix(3);\n        } else {\n            panic(f\"radix must be a power of 2\");\n        }\n    }\n\n    #[test]\n    fn test_to_le_radix_brillig_3() {\n        // this test should only fail in constrained mode\n        if runtime::is_unconstrained() {\n            let field = 1;\n            let out: [u8; 8] = field.to_le_radix(3);\n            let mut expected = [0; 8];\n            expected[0] = 1;\n            assert(out == expected, \"unexpected result\");\n        }\n    }\n\n    #[test(should_fail_with = \"radix must be less than or equal to 256\")]\n    fn test_to_le_radix_512() {\n        // this test should only fail in constrained mode\n        if !runtime::is_unconstrained() {\n            let field = 2;\n            let _: [u8; 8] = field.to_le_radix(512);\n        } else {\n            panic(f\"radix must be less than or equal to 256\")\n        }\n    }\n\n    #[test(should_fail_with = \"Field failed to decompose into specified 16 limbs\")]\n    unconstrained fn not_enough_limbs_brillig() {\n        let _: [u8; 16] = 0x100000000000000000000000000000000.to_le_bytes();\n    }\n\n    #[test(should_fail_with = \"Field failed to decompose into specified 16 limbs\")]\n    fn not_enough_limbs() {\n        let _: [u8; 16] = 0x100000000000000000000000000000000.to_le_bytes();\n    }\n\n    #[test]\n    unconstrained fn test_field_less_than() {\n        assert(field_less_than(0, 1));\n        assert(field_less_than(0, 0x100));\n        assert(field_less_than(0x100, 0 - 1));\n        assert(!field_less_than(0 - 1, 0));\n    }\n\n    #[test]\n    unconstrained fn test_large_field_values_unconstrained() {\n        let large_field = 0xffffffffffffffff;\n\n        let bits: [u1; 64] = large_field.to_le_bits();\n        assert_eq(bits[0], 1);\n\n        let bytes: [u8; 8] = large_field.to_le_bytes();\n        assert_eq(Field::from_le_bytes::<8>(bytes), large_field);\n\n        let radix_bytes: [u8; 8] = large_field.to_le_radix(256);\n        assert_eq(Field::from_le_bytes::<8>(radix_bytes), large_field);\n    }\n\n    #[test]\n    fn test_large_field_values() {\n        let large_val = 0xffffffffffffffff;\n\n        let bits: [u1; 64] = large_val.to_le_bits();\n        assert_eq(bits[0], 1);\n\n        let bytes: [u8; 8] = large_val.to_le_bytes();\n        assert_eq(Field::from_le_bytes::<8>(bytes), large_val);\n\n        let radix_bytes: [u8; 8] = large_val.to_le_radix(256);\n        assert_eq(Field::from_le_bytes::<8>(radix_bytes), large_val);\n    }\n\n    #[test]\n    fn test_decomposition_edge_cases() {\n        let zero_bits: [u1; 8] = 0.to_le_bits();\n        assert_eq(zero_bits, [0; 8]);\n\n        let zero_bytes: [u8; 8] = 0.to_le_bytes();\n        assert_eq(zero_bytes, [0; 8]);\n\n        let one_bits: [u1; 8] = 1.to_le_bits();\n        let expected: [u1; 8] = [1, 0, 0, 0, 0, 0, 0, 0];\n        assert_eq(one_bits, expected);\n\n        let pow2_bits: [u1; 8] = 4.to_le_bits();\n        let expected: [u1; 8] = [0, 0, 1, 0, 0, 0, 0, 0];\n        assert_eq(pow2_bits, expected);\n    }\n\n    #[test]\n    fn test_pow_32() {\n        assert_eq(2.pow_32(3), 8);\n        assert_eq(3.pow_32(2), 9);\n        assert_eq(5.pow_32(0), 1);\n        assert_eq(7.pow_32(1), 7);\n\n        assert_eq(2.pow_32(10), 1024);\n\n        assert_eq(0.pow_32(5), 0);\n        assert_eq(0.pow_32(0), 1);\n\n        assert_eq(1.pow_32(100), 1);\n    }\n\n    #[test]\n    fn test_sgn0() {\n        assert_eq(0.sgn0(), 0);\n        assert_eq(2.sgn0(), 0);\n        assert_eq(4.sgn0(), 0);\n        assert_eq(100.sgn0(), 0);\n\n        assert_eq(1.sgn0(), 1);\n        assert_eq(3.sgn0(), 1);\n        assert_eq(5.sgn0(), 1);\n        assert_eq(101.sgn0(), 1);\n    }\n\n    #[test(should_fail_with = \"Field failed to decompose into specified 8 limbs\")]\n    fn test_bit_decomposition_overflow() {\n        // 8 bits can't represent large field values\n        let large_val = 0x1000000000000000;\n        let _: [u1; 8] = large_val.to_le_bits();\n    }\n\n    #[test(should_fail_with = \"Field failed to decompose into specified 4 limbs\")]\n    fn test_byte_decomposition_overflow() {\n        // 4 bytes can't represent large field values\n        let large_val = 0x1000000000000000;\n        let _: [u8; 4] = large_val.to_le_bytes();\n    }\n\n}\n","path":"std/field/mod.nr"},"50":{"source":"// Identity-based withdraw circuit - the rescoped P2 port (PP-NOIR-FUSION.md P2 + the 2026-07-24\n// \"build the identity-based upgrade... using ERC identity standard\" directive).\n//\n// NOT YET nargo-compiled/tested (standing constraint this session: don't run nargo without\n// approval - see PP-NOIR-FUSION.md's P1 log for the pattern this repo follows once that approval\n// is given: compile, `nargo test`, differential-check against the on-chain reference before\n// trusting it for real value). Written against the SAME gadgets that already passed differential\n// tests (pp::commitment, pp::lean_imt) plus the new pp::identity_asp (cross-checked in Node against\n// the wallet's real derivation, see identity_asp.nr's own test) - not invented from scratch.\n//\n// PUBLIC I/O pinned to PrivacyPool.sol's ProofLib.WithdrawProof.pubSignals (8 elements, unchanged\n// order/count from upstream - the contract does not need to change):\n//   [0] new_commitment          [4] state_tree_depth\n//   [1] existing_nullifier_hash [5] asp_root       <- now an IDENTITY tree root, not a label tree\n//   [2] withdrawn_value         [6] asp_tree_depth\n//   [3] state_root              [7] context\n//\n// `context` is a plain pass-through public signal - PrivacyPool.sol independently recomputes and\n// checks it (keccak256(abi.encode(withdrawal, scope)) % SNARK_SCALAR_FIELD, see ProofLib.context()\n// and PrivacyPool.validWithdrawal) against this same value, so the circuit doesn't need to\n// constrain it against anything else internally; it only needs to be bound as a public input,\n// which `pub` on a Noir main() parameter already guarantees regardless of whether the body\n// references it.\nuse pp::commitment::commitment_hasher;\nuse pp::identity_asp::identity_asp_membership;\nuse pp::lean_imt::lean_imt_inclusion;\nuse pp::smt::smt_verifier_full;\n\n/// SMT depth of the revocation registry. MUST equal RevocationRegistry's constructor `treeHeight_`\n/// and the wallet's REVOCATION_TREE_DEPTH. A mismatch fails every proof with no useful diagnostic.\nglobal REVOCATION_TREE_DEPTH: u32 = 20;\n\n/// `fnc = 1` selects EXCLUSION in smt_verifier_full. Named because passing 0 here would silently\n/// prove the opposite of what this circuit needs - that the identity IS revoked.\nglobal SMT_EXCLUSION: u1 = 1;\n\nfn main(\n    new_commitment: pub Field,\n    existing_nullifier_hash: pub Field,\n    withdrawn_value: pub Field,\n    state_root: pub Field,\n    state_tree_depth: pub Field,\n    asp_root: pub Field,\n    asp_tree_depth: pub Field,\n    context: pub Field,\n    // Root of the revocation registry this proof asserts non-membership of. PrivacyPool checks it\n    // against RevocationRegistry.isValidRoot, so a stale or invented root is rejected on-chain.\n    revocation_root: pub Field,\n    // The existing note being spent.\n    value: Field,\n    label: Field,\n    nullifier: Field,\n    secret: Field,\n    state_leaf_index: Field,\n    state_siblings: [Field; 32],\n    // The change note (remainder after withdrawal) - a fresh commitment, spendable later the same\n    // way. `label` carries over unchanged (it still identifies the deposit lineage for the state\n    // tree / any future ragequit on this same original deposit); only the nullifier/secret pair is\n    // re-derived per withdrawal index, per the wallet's withdrawalSecrets() convention.\n    out_nullifier: Field,\n    out_secret: Field,\n    // Identity-based ASP membership (the actual upgrade) - see pp/src/identity_asp.nr.\n    sk_identity: Field,\n    asp_leaf_index: Field,\n    asp_siblings: [Field; 32],\n    // Non-inclusion witness for the revocation registry, straight from its own getProof(). The\n    // registry is a @solarity SparseMerkleTree; `revocation_is_old0` is the INVERSE of solarity's\n    // `auxExistence` (see the wallet's src/pp/revocation.ts, where the conversion is done).\n    revocation_old_key: Field,\n    revocation_old_value: Field,\n    revocation_is_old0: u1,\n    revocation_siblings: [Field; REVOCATION_TREE_DEPTH],\n) {\n    // 1. Existing note: reconstruct its commitment + nullifier hash, and prove membership in the\n    // PP state tree at `state_root`. `state_tree_depth` is a public signal (contract-selectable,\n    // capped at MAX_TREE_DEPTH=32 on-chain, see State.sol) taken directly as the actual depth - a\n    // false depth simply fails to reconstruct `state_root`, so no separate range check is needed\n    // beyond lean_imt_inclusion's own `assert(actual_depth <= MAX_DEPTH)`.\n    let existing = commitment_hasher(value, label, nullifier, secret);\n    assert(existing.nullifier_hash == existing_nullifier_hash);\n    let computed_state_root = lean_imt_inclusion(\n        existing.commitment,\n        state_leaf_index,\n        state_siblings,\n        state_tree_depth as u32,\n    );\n    assert(computed_state_root == state_root);\n\n    // 2. Value conservation: existing value == withdrawn + carried into the change note.\n    // Range-checked to 128 bits (ample for token amounts) via to_le_bits' own constraint, so the\n    // subtraction below can't wrap the ~254-bit field and hide a fabricated balance.\n    let _value_bits: [u1; 128] = value.to_le_bits();\n    let _withdrawn_bits: [u1; 128] = withdrawn_value.to_le_bits();\n    let new_value = value - withdrawn_value;\n    let _new_value_bits: [u1; 128] = new_value.to_le_bits();\n\n    // 3. Change note commitment.\n    let out = commitment_hasher(new_value, label, out_nullifier, out_secret);\n    assert(out.commitment == new_commitment);\n\n    // 4. Identity-based ASP membership: the withdrawer must know an sk_identity whose holder_root\n    // (Poseidon(pubkey(sk_identity)), the SAME value rarime's HolderStateKeeper anchors) is\n    // included in the identity ASP tree at `asp_root`. This is the actual upgrade over upstream's\n    // per-label membership check - see pp/src/identity_asp.nr for the full rationale.\n    let membership = identity_asp_membership(\n        sk_identity,\n        asp_root,\n        asp_leaf_index,\n        asp_siblings,\n        asp_tree_depth as u32,\n    );\n\n    // 5. NOT REVOKED. The withdrawer must show their holder_root is ABSENT from the revocation\n    // registry at `revocation_root`. This is the second half of TODO.md sec. 2.5: admission alone\n    // is no longer sufficient, and revocation is the only thing that can withdraw it.\n    //\n    // The key is `membership.holder_root` - the SAME value just proven to be an ASP member - not a\n    // free input. Letting the prover choose the key would make this vacuous: they would simply\n    // prove non-revocation of an identity that was never revoked and withdraw as someone else.\n    //\n    // smt_verifier_full's own `assert_keys_ok` additionally makes it impossible to claim exclusion\n    // while pointing at the very key being queried, so a revoked identity cannot pass by supplying\n    // itself as the occupying leaf.\n    let not_revoked = smt_verifier_full::<REVOCATION_TREE_DEPTH>(\n        revocation_root,\n        membership.holder_root,\n        0,\n        revocation_old_key,\n        revocation_old_value,\n        revocation_is_old0,\n        SMT_EXCLUSION,\n        revocation_siblings,\n    );\n    assert(not_revoked == 1, \"identity is revoked, or the non-inclusion witness is invalid\");\n}\n","path":"/Users/ricktobacco/Documents/quidmint/ibiza/backend/circuits/withdraw_identity/src/main.nr"},"51":{"source":"// Commitment hasher - faithful port of PP's commitment.circom.\n//\n//   nullifierHash   = Poseidon1(nullifier)\n//   precommitment   = Poseidon2(nullifier, secret)\n//   commitment      = Poseidon3(value, label, precommitment)\n//\n// circomlib-Poseidon (fixed arity) via noir-lang/poseidon - identical to the wallet's @iden3\n// derivation (src/pp/notes.ts) and the on-chain poseidon-solidity, so commitments match end-to-end.\n// noir-lang/poseidon's own bn254.nr states it is \"Consistent with Circom's implementation\".\n//\n// CONFIRMED on dev machine (nargo 1.0.0-beta.1, poseidon tag v0.1.0): import path is\n// `poseidon::poseidon::bn254` (package `poseidon` re-exports `pub mod poseidon;` in lib.nr, which\n// itself contains the `bn254` submodule) - NOT `poseidon::bn254`.\nuse poseidon::poseidon::bn254;\n\npub struct Commitment {\n    pub commitment: Field,\n    pub nullifier_hash: Field,\n}\n\npub fn commitment_hasher(value: Field, label: Field, nullifier: Field, secret: Field) -> Commitment {\n    let nullifier_hash = bn254::hash_1([nullifier]);\n    let precommitment = bn254::hash_2([nullifier, secret]);\n    let commitment = bn254::hash_3([value, label, precommitment]);\n\n    Commitment { commitment, nullifier_hash }\n}\n\n// Differential test vector, cross-checked against poseidon-solidity's PoseidonT2/T3/T4 on\n// 2026-07-01 (see PP-NOIR-FUSION.md P0 log) - the SAME functions PP's own PrivacyPool.sol calls\n// (PoseidonT4.hash for the commitment), so this checks the exact on-chain computation.\n#[test]\nfn test_matches_poseidon_solidity() {\n    let c = commitment_hasher(10, 20, 30, 40);\n    assert(c.nullifier_hash == 7532086780038402662674345296860422071861903663404908958571451852914592667893);\n    assert(c.commitment == 10718981984499290237711722178490140094119483277114902091282087901089143679380);\n}\n","path":"/Users/ricktobacco/Documents/quidmint/ibiza/backend/circuits/pp/src/commitment.nr"},"53":{"source":"// holder_root derivation - the identity commitment shared by circuit, contract and wallet.\n//\n// COPIED VERBATIM from rarime's noir_dl_lib/src/not_passports_zk_circuits.rs\n// `extract_pk_identity_hash`. See jubjub.nr's header for why PP carries its own copy rather than\n// depending on the whole passport library.\n//\n// MUST stay byte-identical to:\n//   - HolderStateKeeper.sol's `holderRoot` / `identityKey` (Poseidon(pubkey(sk_identity)))\n//   - the wallet's RarimeUtils.getProfileKey\n// The published test vectors in identity_asp.nr / title_holder.nr are the enforcement.\nuse crate::jubjub::priv_to_pub;\nuse poseidon::poseidon::PoseidonHasher;\nuse std::hash::Hasher;\n\n/// Poseidon(pubkey(sk_identity).x, pubkey(sk_identity).y).\npub fn extract_pk_identity_hash(sk_identity: Field) -> Field {\n    let mut hasher = PoseidonHasher::default();\n    let point = priv_to_pub(sk_identity);\n    hasher.write(point.0);\n    hasher.write(point.1);\n\n    hasher.finish()\n}\n","path":"/Users/ricktobacco/Documents/quidmint/ibiza/backend/circuits/pp/src/holder_root.nr"},"54":{"source":"// Identity-based ASP membership - the rescoped P2 upgrade (see PP-NOIR-FUSION.md P2 and the\n// 2026-07-24 directive: \"build the identity-based upgrade now using ERC identity standard\").\n//\n// UPSTREAM (0xbow) PROBLEM: ASP membership is keyed by `label`, a value pinned per DEPOSIT\n// (commitment.nr). Association-set clearance is therefore a property of one deposit event, not of\n// the depositor - an already-cleared identity gets no benefit for any OTHER deposit, and\n// clearance can't be reused as a standalone fact (\"this identity passed screening\") outside the\n// specific note it was proven for.\n//\n// THIS GADGET proves ASP membership of an IDENTITY instead. The leaf is\n// `holder_root = Poseidon2(pubkey(sk_identity).x, pubkey(sk_identity).y)` - the SAME durable\n// commitment rarime's own HolderStateKeeper anchors as `holderRoot`\n// (backend/contracts/contracts/holder/HolderStateKeeper.sol: \"holder root (durable) = identityKey\n// = Poseidon(pubkey(sk_identity))\") and every document leaf is bound under\n// (`Poseidon2(documentKey, holderRoot)`), and that the wallet computes as `profileKey`\n// (frontend/identity-wallet/src/sdk/RarimeUtils.ts getProfileKey). We reuse\n// `noir_dl::not_passports_zk_circuits::extract_pk_identity_hash` - the EXACT function rarime's own\n// register_identity circuit uses for this value (not_passports_zk_circuits.nr, called with\n// `sk_identity` there too) - rather than reimplement the EC scalar-mult + hash, so there is ONE\n// definition of \"this identity's commitment\" shared by the holder tree, this ASP tree, and the\n// wallet, not three that could drift.\n//\n// `sk_identity` is a PRIVATE witness, never a public signal - the proof shows \"the prover knows an\n// sk_identity whose holder_root is included in the tree at `asp_root`\" without revealing WHICH\n// member it is. Anonymity set = every ASP-cleared identity, matching upstream's per-label\n// anonymity set (also never exposes `label` publicly - see PrivacyPool.sol's WithdrawProof\n// pubSignals, which likewise omits it), just re-keyed from \"cleared deposit\" to \"cleared\n// identity\".\n//\n// REUSABLE CLEARANCE (the actual point): because the leaf is the identity and not a deposit\n// label, ANY of that identity's PP notes can be withdrawn once the identity is cleared - clearance\n// is a durable per-identity fact, not a single-use deposit attribute. This is the mechanism behind\n// \"an already-ASP-cleared identity's clearance becomes reusable, provable evidence\" for\n// peer-vouching (e.g. a NotarialTitle attestation) discussed alongside this upgrade - out of scope\n// for this gadget itself, which only proves membership.\nuse crate::holder_root::extract_pk_identity_hash;\nuse crate::lean_imt::lean_imt_inclusion;\n\npub struct IdentityAspMembership {\n    // Returned, not asserted-equal-to-anything by this function - the caller decides whether to\n    // expose it as a public signal. For withdrawal it should stay private (mirrors upstream: PP's\n    // WithdrawProof never exposes `label` either), so ASP membership doesn't deanonymize identity\n    // by revealing which member of the set is withdrawing.\n    pub holder_root: Field,\n}\n\n/// Proves `sk_identity` derives `holder_root`, and that `holder_root` is included in the ASP\n/// LeanIMT rooted at `asp_root`. `asp_root` is expected to be the Entrypoint's currently-active,\n/// evidence-registry-anchored root (Entrypoint.updateRoot / latestActiveRoot) - this gadget only\n/// checks tree inclusion; root freshness/activation-delay is enforced on-chain, unchanged from the\n/// existing label-based scheme (Entrypoint doesn't care what a leaf represents).\npub fn identity_asp_membership<let MAX_DEPTH: u32>(\n    sk_identity: Field,\n    asp_root: Field,\n    leaf_index: Field,\n    siblings: [Field; MAX_DEPTH],\n    actual_depth: u32,\n) -> IdentityAspMembership {\n    let holder_root = extract_pk_identity_hash(sk_identity);\n    let computed_root = lean_imt_inclusion(holder_root, leaf_index, siblings, actual_depth);\n    assert(computed_root == asp_root);\n\n    IdentityAspMembership { holder_root }\n}\n\n// Cross-checked EMPIRICALLY (2026-07-24, not \"by construction\") against the wallet's real\n// derivation path, using @iden3/js-crypto's babyJub + Poseidon (already established this session\n// as byte-identical to noir-lang/poseidon's bn254::hash_N / poseidon-solidity - see commitment.nr\n// and notes.ts's cross-check log) - the SAME primitives RarimeUtils.getProfileKey uses:\n//   pubPoint = babyJub.mulPointEScalar(babyJub.Base8, 1234n)\n//   holder_root = Poseidon.hash(pubPoint)              == 11639338456537070031828088151704016282968167813614481831572112488559037365741\n//   asp_root    = Poseidon.hash([holder_root, 99999n]) == 6236689451309527230350628968094528759868141833300921467691845026671532338086\n// (depth-1 tree: leaf_index 0 => holder_root is the LEFT child, 99999 the RIGHT sibling, matching\n// lean_imt.nr's bit-0-is-left convention.) This checks extract_pk_identity_hash's OUTPUT value\n// against a real, independent implementation; it does not itself run nargo (restricted this\n// session - run `nargo test` to execute this assertion once approved).\n#[test]\nfn test_matches_wallet_profile_key_derivation() {\n    let sk_identity: Field = 1234;\n    let expected_holder_root: Field =\n        11639338456537070031828088151704016282968167813614481831572112488559037365741;\n    let expected_asp_root: Field =\n        6236689451309527230350628968094528759868141833300921467691845026671532338086;\n\n    let result = identity_asp_membership(sk_identity, expected_asp_root, 0, [99999], 1);\n    assert(result.holder_root == expected_holder_root);\n}\n","path":"/Users/ricktobacco/Documents/quidmint/ibiza/backend/circuits/pp/src/identity_asp.nr"},"55":{"source":"// Baby Jubjub scalar multiplication - COPIED VERBATIM from rarime's noir_dl_lib/src/jubjub.nr.\n//\n// WHY A COPY AND NOT AN IMPORT. `pp` needed exactly ONE function out of noir_dl_lib\n// (`extract_pk_identity_hash`, 9 lines) which needs exactly ONE helper (`priv_to_pub`, below).\n// Importing them dragged the ENTIRE ~16k-line passport-verification library - sigver, big_curve,\n// bignum, all the ECDSA curve machinery - into every PP circuit, none of which PP uses. That made\n// the PP circuits hostage to migrating a library they do not need (527 compile errors on modern\n// nargo, none of them in PP's own code). See TODO.md.\n//\n// DO NOT \"clean up\" or re-derive this. `priv_to_pub` defines `holder_root`, the durable identity\n// commitment that HolderStateKeeper anchors on-chain and the wallet computes as `profileKey`. Any\n// change here silently forks identity across circuit / contract / wallet. It is deliberately a\n// byte-identical copy so the three stay in agreement; the published test vectors in\n// identity_asp.nr and title_holder.nr are what enforce that.\n//\n// This file has ZERO imports, which is what made the extraction clean.\n\n/**\n * Scalar multiplication by an ARBITRARY base point.\n *\n * `priv_to_pub` is this same double-and-add ladder with the generator hardcoded; it now delegates\n * here rather than carrying a second copy of a 254-iteration loop. The ALGORITHM is unchanged, so\n * the \"byte-identical to rarime's noir_dl_lib\" property above still holds where it matters - the\n * VALUES. `test_priv_to_pub_matches_babyjub` and `test_priv_to_pub_agrees_with_mul_point` below pin\n * that, so a divergence introduced here cannot pass silently.\n *\n * NEEDED FOR HASHED ELGAMAL (TODO.md sec. 2.13d): sealing the revocation secret to the controller's\n * key requires `r*PK` for a published `PK`, not just `r*G`. That is the ONLY primitive the envelope\n * scheme was missing.\n */\npub fn mul_point(base_x: Field, base_y: Field, scalar: Field) -> (Field, Field) {\n    let bits: [u1; 254] = scalar.to_be_bits::<254>();\n\n    let mut result_x = base_x * (bits[0] as Field);\n    let mut result_y = base_y * (bits[0] as Field);\n\n    for i in 1..254 {\n        let tmp_double = add_zero(result_x, result_y, result_x, result_y);\n\n        let tmp_add = add_zero(tmp_double.0, tmp_double.1, base_x * (bits[i] as Field), base_y * (bits[i] as Field));\n\n        result_x = tmp_add.0;\n        result_y = tmp_add.1;\n    }\n\n    (result_x, result_y)\n}\n\npub fn priv_to_pub(priv: Field) -> (Field, Field){\n    let base_x = 5299619240641551281634865583518297030282874472190772894086521144482721001553;\n    let base_y = 16950150798460657717958625567821834550301663161624707787222815936182638968203;\n\n    mul_point(base_x, base_y, priv)\n}\n\npub fn add (x1: Field, y1: Field, x2: Field, y2: Field) -> (Field, Field){\n    \n    let a = 168700;\n    let d = 168696;\n    \n    let beta = x1 * y2;\n\n    let gamma = x2 * y1;\n\n    let delta = (y1 - x1 * a) * (x2 + y2);\n\n    let tau = beta * gamma;\n    \n    let x = (beta + gamma) / (1 + d * tau);\n    \n    let y = (delta + a * beta - gamma) / (1 - d * tau);\n\n    (x,y)\n}\n\npub fn add_zero(x1: Field, y1: Field, x2: Field, y2: Field) -> (Field, Field){\n    \n    let a = 168700;\n    let d = 168696;\n    \n    let beta = x1 * y2;\n\n    let gamma = x2 * y1;\n\n    let delta = (y1 - x1 * a) * (x2 + y2);\n\n    let tau = beta * gamma;\n    \n    let x = (beta + gamma) / (1 + d * tau);\n    \n    let y = (delta + a * beta - gamma) / (1 - d * tau);\n\n    let is_zero_x = x.eq(0) as Field;\n    let is_zero_y = y.eq(0) as Field;\n    (x + is_zero_x * (x1 + x2), y + is_zero_y * (y1 + y2))\n}\n\n/*\n * DIFFERENTIAL TESTS against @iden3/js-crypto's babyJub - the SAME implementation the wallet uses\n * in RarimeUtils.getProfileKey and that HolderStateKeeper matches on-chain.\n *\n * These tests were previously `print(...)` ONLY, with no assertion: they could not fail whatever\n * the arithmetic returned. That mattered more here than almost anywhere else in this tree, because\n * `priv_to_pub` is what holder_root.nr::extract_pk_identity_hash is built on, which is in turn the\n * identity the ENTIRE ASP membership check rests on. A wrong curve op would have silently produced\n * a holderRoot nobody could ever prove membership for.\n */\nglobal BASE8_X: Field =\n    5299619240641551281634865583518297030282874472190772894086521144482721001553;\nglobal BASE8_Y: Field =\n    16950150798460657717958625567821834550301663161624707787222815936182638968203;\n\n#[test]\nfn test_priv_to_pub_matches_babyjub() {\n    let (x, y) = priv_to_pub(\n        287325206580568373396753082727527032974277810276511506339905121597618812140,\n    );\n    assert(\n        x == 12081729948048517337246964937487237071030796896339407151541092529192354593778,\n        \"priv_to_pub x disagrees with @iden3/js-crypto\",\n    );\n    assert(\n        y == 13485271700701647896810695035716445613077224148409999701152245885507304360556,\n        \"priv_to_pub y disagrees with @iden3/js-crypto\",\n    );\n}\n\n#[test]\nfn test_add_doubling_matches_babyjub() {\n    // G + G\n    let (x, y) = add(BASE8_X, BASE8_Y, BASE8_X, BASE8_Y);\n    assert(\n        x == 10031262171927540148667355526369034398030886437092045105752248699557385197826,\n        \"add(G,G) x disagrees with @iden3/js-crypto\",\n    );\n    assert(\n        y == 633281375905621697187330766174974863687049529291089048651929454608812697683,\n        \"add(G,G) y disagrees with @iden3/js-crypto\",\n    );\n}\n\n#[test]\nfn test_add_identity_is_neutral() {\n    // (0,1) is the neutral element on this twisted Edwards curve, so G + O == G. This is the\n    // property `add_zero` exists to handle; asserting it pins that the zero case is not silently\n    // returning something else.\n    let (x, y) = add(BASE8_X, BASE8_Y, 0, 1);\n    assert(x == BASE8_X, \"G + identity changed x\");\n    assert(y == BASE8_Y, \"G + identity changed y\");\n}\n\n#[test]\nfn test_priv_to_pub_is_deterministic() {\n    // Guards against any hidden state in the scalar-mult ladder.\n    let a = priv_to_pub(1234);\n    let b = priv_to_pub(1234);\n    assert(a.0 == b.0, \"priv_to_pub is not deterministic in x\");\n    assert(a.1 == b.1, \"priv_to_pub is not deterministic in y\");\n}\n\n/*\n * mul_point differential vectors, generated with the SAME @iden3/js-crypto babyJub the wallet uses:\n *   const P = babyJub.mulPointEScalar(babyJub.Base8, 7n);\n *   babyJub.mulPointEScalar(P, k);\n * The base here is 7*G - deliberately NOT the generator, since the whole point of this function is\n * the arbitrary-base case that `priv_to_pub` cannot exercise.\n */\nglobal P7_X: Field =\n    20092560661213339045022877747484245238324772779820628739268223482659246842641;\nglobal P7_Y: Field =\n    12112450042127193446189577552007703839818242727902437791835414514847797088033;\n\n#[test]\nfn test_mul_point_arbitrary_base_matches_babyjub() {\n    // k = 1 must return the base unchanged.\n    let (x1, y1) = mul_point(P7_X, P7_Y, 1);\n    assert(x1 == P7_X, \"mul_point k=1 changed x\");\n    assert(y1 == P7_Y, \"mul_point k=1 changed y\");\n\n    let (x2, y2) = mul_point(P7_X, P7_Y, 2);\n    assert(\n        x2 == 6271573312546148160329629673815240458676221818610765478794395550121752710497,\n        \"mul_point k=2 x disagrees with @iden3/js-crypto\",\n    );\n    assert(\n        y2 == 20729133862440981855920571719405839551572203482913253618619962546642052100217,\n        \"mul_point k=2 y disagrees with @iden3/js-crypto\",\n    );\n\n    let (x3, y3) = mul_point(P7_X, P7_Y, 1234);\n    assert(\n        x3 == 2619422398913205517721050840173764742879764528778505985725959064167656990051,\n        \"mul_point k=1234 x disagrees with @iden3/js-crypto\",\n    );\n    assert(\n        y3 == 16242328633187437272560829965814618299556668067593458319733392253491992277345,\n        \"mul_point k=1234 y disagrees with @iden3/js-crypto\",\n    );\n\n    // A full-width scalar - the size an ElGamal ephemeral actually is, not a toy value.\n    let (x4, y4) = mul_point(\n        P7_X,\n        P7_Y,\n        287325206580568373396753082727527032974277810276511506339905121597618812140,\n    );\n    assert(\n        x4 == 3513951964870253406393337057243839718706719782505248549705257732269741494284,\n        \"mul_point full-width x disagrees with @iden3/js-crypto\",\n    );\n    assert(\n        y4 == 14992476063324944445699325667800157043043257911372429918067253830783895370779,\n        \"mul_point full-width y disagrees with @iden3/js-crypto\",\n    );\n}\n\n#[test]\nfn test_priv_to_pub_agrees_with_mul_point() {\n    // priv_to_pub now DELEGATES to mul_point, so this pins the refactor: if the generalised ladder\n    // ever diverges from the hardcoded-generator one, holder_root forks across circuit / contract /\n    // wallet, which is the exact failure this file's header warns about.\n    let a = priv_to_pub(1234);\n    let b = mul_point(BASE8_X, BASE8_Y, 1234);\n    assert(a.0 == b.0, \"priv_to_pub and mul_point disagree in x\");\n    assert(a.1 == b.1, \"priv_to_pub and mul_point disagree in y\");\n}\n\n#[test]\nfn test_mul_point_by_zero_returns_the_sentinel_not_the_identity() {\n    // A zero scalar returns (0,0), NOT the curve identity (0,1). This ladder uses (0,0) as the\n    // \"empty accumulator\" sentinel - that is what `add_zero`'s is_zero correction exists for - and\n    // (0,0) does not even satisfy the curve equation (a*0 + 0 == 1 + d*0 is 0 == 1, false).\n    //\n    // ASSERTED BECAUSE IT IS THE EXACT DEGENERACY THE ENVELOPE'S `r != 0` GUARD REJECTS\n    // (TODO.md sec. 2.13d). With r = 0 the hashed-ElGamal shared secret is mul_point(PK, 0) =\n    // (0,0) for EVERY controller key, so the mask Poseidon2([0,0]) is a public constant and\n    // C2 = s + mask discloses the sealed revocation secret to anyone who looks. This test was\n    // written asserting (0,1) and FAILED, which is how the real value was established rather than\n    // assumed - the guard is protecting against something now measured, not imagined.\n    let (x, y) = mul_point(P7_X, P7_Y, 0);\n    assert(x == 0, \"mul_point k=0 x is not the sentinel\");\n    assert(y == 0, \"mul_point k=0 y is not the sentinel\");\n\n    // And it is base-independent, which is what makes the leak universal rather than key-specific.\n    let (gx, gy) = mul_point(BASE8_X, BASE8_Y, 0);\n    assert(gx == 0, \"mul_point k=0 over G x is not the sentinel\");\n    assert(gy == 0, \"mul_point k=0 over G y is not the sentinel\");\n}\n\n#[test]\nfn test_distinct_keys_give_distinct_points() {\n    // If this failed, distinct identities could collide onto one holderRoot.\n    let a = priv_to_pub(1234);\n    let b = priv_to_pub(1235);\n    assert((a.0 != b.0) | (a.1 != b.1), \"two different scalars produced the same public point\");\n}\n","path":"/Users/ricktobacco/Documents/quidmint/ibiza/backend/circuits/pp/src/jubjub.nr"},"56":{"source":"// LeanIMT inclusion proof - faithful port of PP's merkleTree.circom (LeanIMTInclusionProof).\n// This is the ONE gadget with no drop-in Noir library, so it's a line-for-line translation of the\n// Circom, kept algebraic (no `if`) to mirror the original constraints exactly.\n//\n// LeanIMT rule (the part a generic Merkle gadget gets wrong): when a node's sibling is EMPTY (== 0),\n// the node is carried up UNCHANGED; otherwise the node is Poseidon2 of the ordered (left,right) pair.\n// Circom: nodes[i+1] = (nodes[i] - h) * siblingIsEmpty + h.\n//\n// Hashing is circomlib-Poseidon via noir-lang/poseidon - must match the on-chain @zk-kit/lean-imt.sol\n// (which hashes with PoseidonT3 / circomlib). Differential-tested against lean-imt.sol: 46 randomized\n// (leaf, index, siblings, depth) vectors below, all passing (`nargo test`, confirmed 2026-07-26).\n//\n// CONFIRMED on dev machine (nargo 1.0.0-beta.1, poseidon tag v0.1.0): import path is\n// `poseidon::poseidon::bn254`, NOT `poseidon::bn254` (see commitment.nr for detail).\nuse poseidon::poseidon::bn254;\n\npub fn lean_imt_inclusion<let MAX_DEPTH: u32>(\n    leaf: Field,\n    leaf_index: Field,\n    siblings: [Field; MAX_DEPTH],\n    actual_depth: u32,\n) -> Field {\n    // actualDepth is only a bound in the Circom (|siblings| <= actualDepth <= maxDepth).\n    assert(actual_depth <= MAX_DEPTH);\n\n    // Path bits of the leaf index (LSB = level 0), as in Circom's Num2Bits(maxDepth).\n    let indices: [u1; MAX_DEPTH] = leaf_index.to_le_bits();\n\n    let mut node = leaf;\n    for i in 0..MAX_DEPTH {\n        let sibling = siblings[i];\n        let bit = indices[i] as Field; // 0 => current node is the left child, 1 => the right child\n\n        // Order the pair by the path bit (algebraic switcher, == Circom's DualMux).\n        let left = node + bit * (sibling - node); // bit 0 => node,    bit 1 => sibling\n        let right = sibling + bit * (node - sibling); // bit 0 => sibling, bit 1 => node\n\n        let hashed = bn254::hash_2([left, right]);\n\n        // Carry-up when the sibling is empty (== 0), else take the hash. == Circom line 74.\n        let sibling_is_empty = (sibling == 0) as Field;\n        node = (node - hashed) * sibling_is_empty + hashed;\n    }\n\n    node\n}\n\n// Differential test vector, cross-checked against @zk-kit/lean-imt.sol + poseidon-solidity on\n// 2026-07-01 (see PP-NOIR-FUSION.md P0 log). Tree: insert(1), insert(2), insert(3) (3 leaves, depth\n// 2). h01 = PoseidonT3.hash([1,2]); root = PoseidonT3.hash([h01,3]); LeanIMT.sol's `root()` was\n// asserted equal to this hand-derived root on-chain before taking these numbers.\n#[test]\nfn test_matches_lean_imt_sol_three_leaves() {\n    let leaf: Field = 1;\n    let sibling_l0: Field = 2; // L1\n    let sibling_l1: Field = 3; // L2 (carried up at level 0, so it's node1 = L2 itself)\n    let expected_root: Field = 13816780880028945690020260331303642730075999758909899334839547418969502592169;\n\n    let root = lean_imt_inclusion(leaf, 0, [sibling_l0, sibling_l1], 2);\n    assert(root == expected_root);\n}\n\n// FUZZED differential vectors (2026-07-24, closes the P1-remaining gap PP-NOIR-FUSION.md flagged:\n// \"particularly the LeanIMT carry-up edge case, odd leaf counts at multiple levels\"). Generated\n// from 10 real LeanIMT trees (sizes 1,2,3,4,5,6,7,8,13,37 - chosen to hit every parity/carry-up\n// combination up to MAX_DEPTH=8, including multi-level carries at size 37), built and proven in\n// Node with @iden3/js-crypto's Poseidon - the SAME primitive already cross-checked this session as\n// byte-identical to noir-lang/poseidon's bn254::hash_2 and poseidon-solidity's PoseidonT3 (see\n// commitment.nr, identity_asp.nr). Construction mirrors InternalLeanIMT.sol's insert-order-\n// dependent algorithm (carry a node up unchanged when its sibling is empty), not just a\n// root-checking formula. 46 vectors, every leaf of every tree up to size 8, a representative\n// sample (first two / middle / last two) for the larger trees. Not yet run (nargo restricted this\n// session) - `nargo test` should confirm all 46 pass before this is trusted for real value.\n\n#[test]\nfn test_fuzz_0_size1_index0() {\n    let leaf: Field = 771542434896270695;\n    let siblings: [Field; 8] = [0, 0, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 771542434896270695;\n    let root = lean_imt_inclusion(leaf, 0, siblings, 0);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_1_size2_index0() {\n    let leaf: Field = 17448036227231216792;\n    let siblings: [Field; 8] = [18220607450983656993, 0, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 4872492189337491109994569408025775109149422060106672696281092769329676785083;\n    let root = lean_imt_inclusion(leaf, 0, siblings, 1);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_2_size2_index1() {\n    let leaf: Field = 18220607450983656993;\n    let siblings: [Field; 8] = [17448036227231216792, 0, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 4872492189337491109994569408025775109149422060106672696281092769329676785083;\n    let root = lean_imt_inclusion(leaf, 1, siblings, 1);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_3_size3_index0() {\n    let leaf: Field = 12690389589401385431;\n    let siblings: [Field; 8] = [3695901138668934445, 1951146152130020494, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5885686806379232589708813548494304953386472061266441823978427574364883829116;\n    let root = lean_imt_inclusion(leaf, 0, siblings, 2);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_4_size3_index1() {\n    let leaf: Field = 3695901138668934445;\n    let siblings: [Field; 8] = [12690389589401385431, 1951146152130020494, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5885686806379232589708813548494304953386472061266441823978427574364883829116;\n    let root = lean_imt_inclusion(leaf, 1, siblings, 2);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_5_size3_index2() {\n    let leaf: Field = 1951146152130020494;\n    let siblings: [Field; 8] = [0, 3040063597165823600073380314538092345766290954341235159052656240521104561325, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5885686806379232589708813548494304953386472061266441823978427574364883829116;\n    let root = lean_imt_inclusion(leaf, 2, siblings, 2);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_6_size4_index0() {\n    let leaf: Field = 2784286751939579549;\n    let siblings: [Field; 8] = [317150846121963200, 7964850139242718324196978781653575224005306456022843761801150076827548182135, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13366554711718768673334343702538355979233830220441717513832495680012843873485;\n    let root = lean_imt_inclusion(leaf, 0, siblings, 2);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_7_size4_index1() {\n    let leaf: Field = 317150846121963200;\n    let siblings: [Field; 8] = [2784286751939579549, 7964850139242718324196978781653575224005306456022843761801150076827548182135, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13366554711718768673334343702538355979233830220441717513832495680012843873485;\n    let root = lean_imt_inclusion(leaf, 1, siblings, 2);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_8_size4_index2() {\n    let leaf: Field = 9191575278534986803;\n    let siblings: [Field; 8] = [17363085459673843459, 14956227790025048372475856934647233951074699006894669706355180870879998891321, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13366554711718768673334343702538355979233830220441717513832495680012843873485;\n    let root = lean_imt_inclusion(leaf, 2, siblings, 2);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_9_size4_index3() {\n    let leaf: Field = 17363085459673843459;\n    let siblings: [Field; 8] = [9191575278534986803, 14956227790025048372475856934647233951074699006894669706355180870879998891321, 0, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13366554711718768673334343702538355979233830220441717513832495680012843873485;\n    let root = lean_imt_inclusion(leaf, 3, siblings, 2);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_10_size5_index0() {\n    let leaf: Field = 7781853593656935723;\n    let siblings: [Field; 8] = [9555585195642170100, 8701259702523108370678798259235950596964081891000804989751557162955111836200, 3819499890691151335, 0, 0, 0, 0, 0];\n    let expected_root: Field = 20015743656346873681370225358503160585774786889988534312485824212214054743262;\n    let root = lean_imt_inclusion(leaf, 0, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_11_size5_index1() {\n    let leaf: Field = 9555585195642170100;\n    let siblings: [Field; 8] = [7781853593656935723, 8701259702523108370678798259235950596964081891000804989751557162955111836200, 3819499890691151335, 0, 0, 0, 0, 0];\n    let expected_root: Field = 20015743656346873681370225358503160585774786889988534312485824212214054743262;\n    let root = lean_imt_inclusion(leaf, 1, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_12_size5_index2() {\n    let leaf: Field = 12596043717543206001;\n    let siblings: [Field; 8] = [2573283321815358863, 1473870082597004751432148851387953793929332102427177748493801474884966588271, 3819499890691151335, 0, 0, 0, 0, 0];\n    let expected_root: Field = 20015743656346873681370225358503160585774786889988534312485824212214054743262;\n    let root = lean_imt_inclusion(leaf, 2, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_13_size5_index3() {\n    let leaf: Field = 2573283321815358863;\n    let siblings: [Field; 8] = [12596043717543206001, 1473870082597004751432148851387953793929332102427177748493801474884966588271, 3819499890691151335, 0, 0, 0, 0, 0];\n    let expected_root: Field = 20015743656346873681370225358503160585774786889988534312485824212214054743262;\n    let root = lean_imt_inclusion(leaf, 3, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_14_size5_index4() {\n    let leaf: Field = 3819499890691151335;\n    let siblings: [Field; 8] = [0, 0, 21775435753822882247008479331658933587327274153299346971976454586806997434762, 0, 0, 0, 0, 0];\n    let expected_root: Field = 20015743656346873681370225358503160585774786889988534312485824212214054743262;\n    let root = lean_imt_inclusion(leaf, 4, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_15_size6_index0() {\n    let leaf: Field = 6927654554759505180;\n    let siblings: [Field; 8] = [6776555738542438135, 11741663866724274065017805127783416570027340306358741780185433815584176999329, 8918404965939824566303745658978339786840000927016672069922166095786634529113, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13161033659012153155959476726976812078279254416945611756871563053408440778409;\n    let root = lean_imt_inclusion(leaf, 0, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_16_size6_index1() {\n    let leaf: Field = 6776555738542438135;\n    let siblings: [Field; 8] = [6927654554759505180, 11741663866724274065017805127783416570027340306358741780185433815584176999329, 8918404965939824566303745658978339786840000927016672069922166095786634529113, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13161033659012153155959476726976812078279254416945611756871563053408440778409;\n    let root = lean_imt_inclusion(leaf, 1, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_17_size6_index2() {\n    let leaf: Field = 10945018005205075438;\n    let siblings: [Field; 8] = [7751554709412647974, 13045641299397352791857558739113670995315855876601633162081248183434281810407, 8918404965939824566303745658978339786840000927016672069922166095786634529113, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13161033659012153155959476726976812078279254416945611756871563053408440778409;\n    let root = lean_imt_inclusion(leaf, 2, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_18_size6_index3() {\n    let leaf: Field = 7751554709412647974;\n    let siblings: [Field; 8] = [10945018005205075438, 13045641299397352791857558739113670995315855876601633162081248183434281810407, 8918404965939824566303745658978339786840000927016672069922166095786634529113, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13161033659012153155959476726976812078279254416945611756871563053408440778409;\n    let root = lean_imt_inclusion(leaf, 3, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_19_size6_index4() {\n    let leaf: Field = 7790918266563407587;\n    let siblings: [Field; 8] = [11918846932918903861, 0, 17138227530356453200250746059311538328221851152930257775964377926749113431634, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13161033659012153155959476726976812078279254416945611756871563053408440778409;\n    let root = lean_imt_inclusion(leaf, 4, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_20_size6_index5() {\n    let leaf: Field = 11918846932918903861;\n    let siblings: [Field; 8] = [7790918266563407587, 0, 17138227530356453200250746059311538328221851152930257775964377926749113431634, 0, 0, 0, 0, 0];\n    let expected_root: Field = 13161033659012153155959476726976812078279254416945611756871563053408440778409;\n    let root = lean_imt_inclusion(leaf, 5, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_21_size7_index0() {\n    let leaf: Field = 15628034858974114649;\n    let siblings: [Field; 8] = [9494284577974599804, 6629185819996052357613038257168589869375616172862477003331219633576109943984, 9588177920740044990655729971034531611511127743028177095590020460971270303839, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5301077719357616074802874993195774557988803210589255316803246521977389207755;\n    let root = lean_imt_inclusion(leaf, 0, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_22_size7_index1() {\n    let leaf: Field = 9494284577974599804;\n    let siblings: [Field; 8] = [15628034858974114649, 6629185819996052357613038257168589869375616172862477003331219633576109943984, 9588177920740044990655729971034531611511127743028177095590020460971270303839, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5301077719357616074802874993195774557988803210589255316803246521977389207755;\n    let root = lean_imt_inclusion(leaf, 1, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_23_size7_index2() {\n    let leaf: Field = 12681318555153330327;\n    let siblings: [Field; 8] = [4631286202442100965, 1899257402226927357452699883901718593683635383623052983846403713135994513285, 9588177920740044990655729971034531611511127743028177095590020460971270303839, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5301077719357616074802874993195774557988803210589255316803246521977389207755;\n    let root = lean_imt_inclusion(leaf, 2, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_24_size7_index3() {\n    let leaf: Field = 4631286202442100965;\n    let siblings: [Field; 8] = [12681318555153330327, 1899257402226927357452699883901718593683635383623052983846403713135994513285, 9588177920740044990655729971034531611511127743028177095590020460971270303839, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5301077719357616074802874993195774557988803210589255316803246521977389207755;\n    let root = lean_imt_inclusion(leaf, 3, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_25_size7_index4() {\n    let leaf: Field = 6297765070207019386;\n    let siblings: [Field; 8] = [18006511486316440406, 18296083989700797552, 2035991619178336174720429423234685619889915608119491779821822533399109852551, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5301077719357616074802874993195774557988803210589255316803246521977389207755;\n    let root = lean_imt_inclusion(leaf, 4, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_26_size7_index5() {\n    let leaf: Field = 18006511486316440406;\n    let siblings: [Field; 8] = [6297765070207019386, 18296083989700797552, 2035991619178336174720429423234685619889915608119491779821822533399109852551, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5301077719357616074802874993195774557988803210589255316803246521977389207755;\n    let root = lean_imt_inclusion(leaf, 5, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_27_size7_index6() {\n    let leaf: Field = 18296083989700797552;\n    let siblings: [Field; 8] = [0, 17878177957706099491437451327467445607273922719065030759006313815883850757520, 2035991619178336174720429423234685619889915608119491779821822533399109852551, 0, 0, 0, 0, 0];\n    let expected_root: Field = 5301077719357616074802874993195774557988803210589255316803246521977389207755;\n    let root = lean_imt_inclusion(leaf, 6, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_28_size8_index0() {\n    let leaf: Field = 2156208954567452673;\n    let siblings: [Field; 8] = [9494724636210700158, 5592684934048244820153346114671855604854313446709835459708745803739225552045, 1272603601787951139179326416143958099757244341295453039184883303042206593521, 0, 0, 0, 0, 0];\n    let expected_root: Field = 17175854267509309966085747885571145670326939902908279468267019279871310684727;\n    let root = lean_imt_inclusion(leaf, 0, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_29_size8_index1() {\n    let leaf: Field = 9494724636210700158;\n    let siblings: [Field; 8] = [2156208954567452673, 5592684934048244820153346114671855604854313446709835459708745803739225552045, 1272603601787951139179326416143958099757244341295453039184883303042206593521, 0, 0, 0, 0, 0];\n    let expected_root: Field = 17175854267509309966085747885571145670326939902908279468267019279871310684727;\n    let root = lean_imt_inclusion(leaf, 1, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_30_size8_index2() {\n    let leaf: Field = 3226449629626982905;\n    let siblings: [Field; 8] = [7144203569905078157, 10226134070307996391501546258380143920177401131919853500464065647932895046723, 1272603601787951139179326416143958099757244341295453039184883303042206593521, 0, 0, 0, 0, 0];\n    let expected_root: Field = 17175854267509309966085747885571145670326939902908279468267019279871310684727;\n    let root = lean_imt_inclusion(leaf, 2, siblings, 3);\n    assert(root == expected_root);\n}\n\n#[test]\nfn test_fuzz_31_size8_index3() {\n    let leaf: Field = 7144203569